{
  "name": "baseline-b2",
  "runs": [
    {
      "id": "b2-baseline",
      "host": "127.0.0.1",
      "port": 33893,
      "username": "harness",
      "passwordEnv": "HARNESS_B2_PASS",
      "repeat": 5,
      "steps": [
        {
          "op": "connect"
        },
        {
          "op": "waitConnected",
          "timeout": 30
        },
        {
          "op": "waitFirstFrame",
          "timeout": 30
        },
        {
          "op": "idle",
          "seconds": 10
        },
        {
          "op": "inputLatency",
          "samples": 50,
          "probeX": 100,
          "probeY": 100
        },
        {
          "op": "tap",
          "seconds": 5
        },
        {
          "op": "resize",
          "width": 1024,
          "height": 700,
          "seconds": 2
        },
        {
          "op": "shutdown"
        }
      ],
      "expect": {
        "connected": true,
        "firstFrame": true,
        "maxShutdownMs": 1000
      },
      "networkAutoDetect": true
    }
  ]
}