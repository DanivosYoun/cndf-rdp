{
  "name": "k1-b1-keyboard",
  "runs": [
    {"id": "b1-keyboard-standard", "host": "127.0.0.1", "port": 33891, "username": "harness", "passwordEnv": "HARNESS_B1_PASS",
     "keyboardProfile": "standard",
     "steps": [{"op": "connect"}, {"op": "waitConnected", "timeout": 30}, {"op": "waitFirstFrame", "timeout": 30},
               {"op": "idle", "seconds": 2}, {"op": "shutdown"}],
     "expect": {"connected": true, "firstFrame": true}},
    {"id": "b1-keyboard-korean", "host": "127.0.0.1", "port": 33891, "username": "harness", "passwordEnv": "HARNESS_B1_PASS",
     "keyboardProfile": "korean",
     "steps": [{"op": "connect"}, {"op": "waitConnected", "timeout": 30}, {"op": "waitFirstFrame", "timeout": 30},
               {"op": "idle", "seconds": 2}, {"op": "shutdown"}],
     "expect": {"connected": true, "firstFrame": true}}
  ]
}
