{
  "name": "m3-b1-channels",
  "runs": [
    {
      "id": "b1-audio-off-folder-off",
      "host": "127.0.0.1",
      "port": 33891,
      "username": "harness",
      "passwordEnv": "HARNESS_B1_PASS",
      "audioMode": 0,
      "shareHome": false,
      "steps": [
        {
          "op": "connect"
        },
        {
          "op": "waitConnected",
          "timeout": 15
        },
        {
          "op": "idle",
          "seconds": 3
        },
        {
          "op": "shutdown"
        }
      ],
      "expect": {
        "connected": true,
        "maxShutdownMs": 1000
      }
    },
