+struct AudioChannelProbe(&'static str);
+
+ironrdp::core::impl_as_any!(AudioChannelProbe);
+
+impl ironrdp::dvc::DvcProcessor for AudioChannelProbe {
+    fn channel_name(&self) -> &str {
+        self.0
+    }
+
+    fn start(&mut self, _id: u32) -> ironrdp::pdu::PduResult<Vec<ironrdp::dvc::DvcMessage>> {
+        info!(name = self.0, accepted = true, "K3 audio DVC");
+        Ok(Vec::new())
+    }
+
+    fn process(&mut self, _id: u32, _payload: &[u8]) -> ironrdp::pdu::PduResult<Vec<ironrdp::dvc::DvcMessage>> {
+        Ok(Vec::new())
+    }
+}
+
+impl ironrdp::dvc::DvcServerProcessor for AudioChannelProbe {
+    fn creation_failed(&mut self, _id: u32, _status: ironrdp::dvc::pdu::CreationStatus) {
+        info!(name = self.0, accepted = false, "K3 audio DVC");
+    }
+}
+
+struct AudioChannelProbeFactory;
+
+impl ironrdp::server::DynamicChannelFactory for AudioChannelProbeFactory {
+    fn attach(&self, channels: ironrdp::dvc::DrdynvcServer) -> ironrdp::dvc::DrdynvcServer {
+        channels
+            .with_dynamic_channel(AudioChannelProbe("AUDIO_PLAYBACK_DVC"))
+            .with_dynamic_channel(AudioChannelProbe("AUDIO_PLAYBACK_LOSSY_DVC"))
+    }
+}
