+    #[test]
+    fn reactivation_timeout_releases_in_flight_resize_and_keeps_latest_request() {
+        let mut queue = ResizeQueue::default();
+        queue.mark_in_flight(resize_request(1024, 768));
+        let deadline = queue.deadline().unwrap();
+        queue.defer(resize_request(1200, 800));
+        let final_request = resize_request(1280, 800);
+        queue.defer(final_request.clone());
+
+        let (_, reason) = queue.timed_out_request(deadline).unwrap();
+        queue.discard_timed_out_request(reason);
+
+        assert!(queue.in_flight.is_none());
+        assert_eq!(queue.pending.unwrap().request, final_request);
+    }
+
