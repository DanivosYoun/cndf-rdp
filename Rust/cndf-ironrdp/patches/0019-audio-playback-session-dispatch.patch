+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::sync::atomic::AtomicUsize;
+    use tracing_subscriber::layer::{Context, SubscriberExt};
+    use tracing_subscriber::Layer;
+
+    struct CountFailures(Arc<AtomicUsize>);
+
+    impl<S: tracing::Subscriber> Layer<S> for CountFailures {
+        fn on_event(&self, event: &tracing::Event<'_>, _: Context<'_, S>) {
+            if matches!(*event.metadata().level(), tracing::Level::WARN | tracing::Level::ERROR) {
+                self.0.fetch_add(1, Ordering::Relaxed);
+            }
+        }
+    }
+
+    #[test]
+    fn playback_thread_emits_to_its_own_session_dispatch() {
+        let first = Arc::new(AtomicUsize::new(0));
+        let second = Arc::new(AtomicUsize::new(0));
+        let first_session = tracing_subscriber::registry().with(CountFailures(Arc::clone(&first)));
+        let second_session = tracing_subscriber::registry().with(CountFailures(Arc::clone(&second)));
+
+        let first_worker = tracing::subscriber::with_default(first_session, || {
+            spawn_playback(|| warn!("playback warning")).unwrap()
+        });
+        let second_worker = tracing::subscriber::with_default(second_session, || {
+            spawn_playback(|| {
+                warn!("playback warning");
+                error!("playback error");
+            })
+            .unwrap()
+        });
+        first_worker.join().unwrap();
+        second_worker.join().unwrap();
+
+        assert_eq!(first.load(Ordering::Relaxed), 1);
+        assert_eq!(second.load(Ordering::Relaxed), 2);
+    }
+}
