+fn spawn_playback(run: impl FnOnce() + Send + 'static) -> std::io::Result<JoinHandle<()>> {
+    let dispatch = tracing::dispatcher::get_default(Clone::clone);
+    thread::Builder::new()
+        .name("rdpsnd-playback".to_owned())
+        .spawn(move || tracing::dispatcher::with_default(&dispatch, run))
+}
