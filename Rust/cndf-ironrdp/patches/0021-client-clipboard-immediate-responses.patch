+/// Server clipboard that requests the first four bytes of the first file the client offers, and reports
+/// the client's file contents responses.
+#[derive(Debug)]
+struct RequestingClipboard {
+    events: Arc<StdMutex<Option<UnboundedSender<ServerEvent>>>>,
+    responses: UnboundedSender<(u32, Option<Vec<u8>>)>,
+}
+
+impl_as_any!(RequestingClipboard);
+
+impl ironrdp::cliprdr::backend::CliprdrBackend for RequestingClipboard {
+    fn temporary_directory(&self) -> &str {
+        ".cliprdr"
+    }
+    fn client_capabilities(&self) -> ironrdp::cliprdr::pdu::ClipboardGeneralCapabilityFlags {
+        ironrdp::cliprdr::pdu::ClipboardGeneralCapabilityFlags::STREAM_FILECLIP_ENABLED
+    }
+    fn on_ready(&mut self) {}
+    fn on_request_format_list(&mut self) {}
+    fn on_process_negotiated_capabilities(&mut self, _: ironrdp::cliprdr::pdu::ClipboardGeneralCapabilityFlags) {}
+    fn on_remote_copy(&mut self, formats: &[ironrdp::cliprdr::pdu::ClipboardFormat]) {
+        if formats.is_empty() {
+            return;
+        }
+        let request = ironrdp::cliprdr::pdu::FileContentsRequest {
+            stream_id: 7,
+            index: 0,
+            flags: ironrdp::cliprdr::pdu::FileContentsFlags::RANGE,
+            position: 0,
+            requested_size: 4,
+            data_id: None,
+        };
+        if let Some(events) = self.events.lock().unwrap().as_ref() {
+            let _ = events.send(ServerEvent::Clipboard(
+                ironrdp::cliprdr::backend::ClipboardMessage::SendFileContentsRequest(request),
+            ));
+        }
+    }
+    fn on_format_data_request(&mut self, _: ironrdp::cliprdr::pdu::FormatDataRequest) {}
+    fn on_format_data_response(&mut self, _: ironrdp::cliprdr::pdu::FormatDataResponse<'_>) {}
+    fn on_file_contents_request(&mut self, _: ironrdp::cliprdr::pdu::FileContentsRequest) {}
+    fn on_file_contents_response(&mut self, response: ironrdp::cliprdr::pdu::FileContentsResponse<'_>) {
+        let data = (!response.is_error()).then(|| response.data().to_vec());
+        let _ = self.responses.send((response.stream_id(), data));
+    }
+    fn on_lock(&mut self, _: ironrdp::cliprdr::pdu::LockDataId) {}
+    fn on_unlock(&mut self, _: ironrdp::cliprdr::pdu::LockDataId) {}
+}
+
+struct RequestingClipboardFactory {
+    events: Arc<StdMutex<Option<UnboundedSender<ServerEvent>>>>,
+    responses: UnboundedSender<(u32, Option<Vec<u8>>)>,
+}
+
+impl ironrdp::cliprdr::backend::CliprdrBackendFactory for RequestingClipboardFactory {
+    fn build_cliprdr_backend(&self) -> Box<dyn ironrdp::cliprdr::backend::CliprdrBackend> {
+        Box::new(RequestingClipboard {
+            events: Arc::clone(&self.events),
+            responses: self.responses.clone(),
+        })
+    }
+}
+
+impl ServerEventSender for RequestingClipboardFactory {
+    fn set_sender(&mut self, sender: UnboundedSender<ServerEvent>) {
+        *self.events.lock().unwrap() = Some(sender);
+    }
+}
+
+impl server::CliprdrServerFactory for RequestingClipboardFactory {}
+
+/// Client clipboard that offers one four-byte file once ready and defers file contents requests, reporting each
+/// with the CLIPRDR processor that received it.
+struct DeferringClipboard {
+    input: ironrdp_client::rdp::RdpInputSender,
+    requests: UnboundedSender<(u32, ironrdp::cliprdr::CliprdrInstance)>,
+}
+
+impl core::fmt::Debug for DeferringClipboard {
+    fn fmt(&self, f: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {
+        f.debug_struct("DeferringClipboard").finish_non_exhaustive()
+    }
+}
+
+impl_as_any!(DeferringClipboard);
+
+impl ironrdp::cliprdr::backend::CliprdrBackend for DeferringClipboard {
+    fn temporary_directory(&self) -> &str {
+        ".cliprdr"
+    }
+    fn client_capabilities(&self) -> ironrdp::cliprdr::pdu::ClipboardGeneralCapabilityFlags {
+        ironrdp::cliprdr::pdu::ClipboardGeneralCapabilityFlags::STREAM_FILECLIP_ENABLED
+    }
+    fn on_ready(&mut self) {
+        let _ = self
+            .input
+            .send_clipboard(ironrdp::cliprdr::backend::ClipboardMessage::SendInitiateFileCopy(vec![
+                ironrdp::cliprdr::pdu::FileDescriptor::new("file.bin").with_file_size(4),
+            ]));
+    }
+    fn on_request_format_list(&mut self) {
+        let _ = self
+            .input
+            .send_clipboard(ironrdp::cliprdr::backend::ClipboardMessage::SendInitiateCopy(Vec::new()));
+    }
+    fn on_process_negotiated_capabilities(&mut self, _: ironrdp::cliprdr::pdu::ClipboardGeneralCapabilityFlags) {}
+    fn on_remote_copy(&mut self, _: &[ironrdp::cliprdr::pdu::ClipboardFormat]) {}
+    fn on_format_data_request(&mut self, _: ironrdp::cliprdr::pdu::FormatDataRequest) {}
+    fn on_format_data_response(&mut self, _: ironrdp::cliprdr::pdu::FormatDataResponse<'_>) {}
+    fn on_file_contents_request(&mut self, _: ironrdp::cliprdr::pdu::FileContentsRequest) {
+        unreachable!("CLIPRDR calls respond_to_file_contents_request");
+    }
+    fn respond_to_file_contents_request(
+        &mut self,
+        request: ironrdp::cliprdr::pdu::FileContentsRequest,
+        instance: ironrdp::cliprdr::CliprdrInstance,
+    ) -> Option<ironrdp::cliprdr::pdu::FileContentsResponse<'static>> {
+        let _ = self.requests.send((request.stream_id, instance));
+        None
+    }
+    fn on_file_contents_response(&mut self, _: ironrdp::cliprdr::pdu::FileContentsResponse<'_>) {}
+    fn on_lock(&mut self, _: ironrdp::cliprdr::pdu::LockDataId) {}
+    fn on_unlock(&mut self, _: ironrdp::cliprdr::pdu::LockDataId) {}
+}
+
+struct DeferringClipboardFactory {
+    input: ironrdp_client::rdp::RdpInputSender,
+    requests: UnboundedSender<(u32, ironrdp::cliprdr::CliprdrInstance)>,
+}
+
+impl ironrdp::cliprdr::backend::CliprdrBackendFactory for DeferringClipboardFactory {
+    fn build_cliprdr_backend(&self) -> Box<dyn ironrdp::cliprdr::backend::CliprdrBackend> {
+        Box::new(DeferringClipboard {
+            input: self.input.clone(),
+            requests: self.requests.clone(),
+        })
+    }
+}
