+/// A deferred file contents response reaches the server only for the CLIPRDR processor that received the request;
+/// one prepared for another processor is discarded before it is encoded, and its completion is dropped.
+// oracle: mutant sending a response prepared for a previous clipboard channel, or signaling its completion
+#[tokio::test]
+async fn client_clipboard_sends_deferred_responses_only_for_the_current_channel() {
+    use ironrdp::cliprdr::backend::ClipboardMessage;
+    use ironrdp::cliprdr::pdu::FileContentsResponse;
+    use ironrdp_client::rdp::{RdpClient, RdpOutputEvent};
+
+    let identity = test_tls_identity();
+    let acceptor = identity.make_acceptor().expect("failed to build TLS acceptor");
+    let (_display_tx, display_rx) = mpsc::unbounded_channel();
+    let (responses_tx, mut responses) = mpsc::unbounded_channel();
+    let mut server = RdpServer::builder()
+        .with_addr(([127, 0, 0, 1], 0))
+        .with_hybrid(acceptor, identity.pub_key)
+        .with_input_handler(TestInputHandler)
+        .with_display_handler(TestDisplay {
+            rx: Arc::new(Mutex::new(display_rx)),
+            offers_display_control: true,
+        })
+        .with_cliprdr_factory(Some(Box::new(RequestingClipboardFactory {
+            events: Arc::default(),
+            responses: responses_tx,
+        })))
+        .build();
+    server.set_credentials(Some(server::Credentials {
+        username: HYBRID_USER.into(),
+        password: HYBRID_PASSWORD.into(),
+        domain: None,
+    }));
+    let handle = server.handle().clone();
+    let local = tokio::task::LocalSet::new();
+    Box::pin(local.run_until(async move {
+        let server_task = tokio::task::spawn_local(async move {
+            let _ = server.run().await;
+        });
+        let server_address = handle.local_addr().await.unwrap().unwrap();
+        let config = ironrdp_client::config::ConfigBuilder::new()
+            .with_destination(ironrdp_client::config::Destination::from_parts(
+                "127.0.0.1",
+                server_address.port(),
+            ))
+            .with_username(HYBRID_USER)
+            .with_password(HYBRID_PASSWORD)
+            .with_credssp(true)
+            .with_client_build(1)
+            .with_client_dir("C:\\")
+            .with_platform(MajorPlatformType::WINDOWS)
+            .with_client_name("client")
+            .with_clipboard(ironrdp_client::config::ClipboardType::Enable)
+            .build()
+            .expect("client configuration");
+        let (output_tx, mut output_rx) = ironrdp_client::output_channel::output_channel(64);
+        let client = RdpClient::new(config, output_tx);
+        let input = client.input_sender();
+        let (requests_tx, mut requests) = mpsc::unbounded_channel();
+        let client = client.with_cliprdr_backend_factory(Box::new(DeferringClipboardFactory {
+            input: input.clone(),
+            requests: requests_tx,
+        }));
+        let client_task = tokio::task::spawn_local(client.run());
+        let events = tokio::task::spawn_local(async move {
+            while let Some(event) = output_rx.recv().await {
+                assert!(
+                    !matches!(event, RdpOutputEvent::ConnectionFailure(_)),
+                    "the client failed: {event:?}"
+                );
+            }
+        });
+        let (stream_id, current) = tokio::time::timeout(Duration::from_secs(20), requests.recv())
+            .await
+            .expect("the server requests file contents in time")
+            .expect("the client clipboard reports the request");
+        assert_eq!(stream_id, 7);
+        let previous = ironrdp::cliprdr::CliprdrClient::new(Box::new(NoClipboard)).instance();
+        assert_ne!(previous, current);
+
+        let response = |data: &[u8]| {
+            ClipboardMessage::SendFileContentsResponse(FileContentsResponse::new_data_response(7, data.to_vec()))
+        };
+        let (completion, stale) = oneshot::channel();
+        input
+            .send_clipboard_for_instance(previous, response(b"OLD!"), completion)
+            .expect("the session is running");
+        let stale = tokio::time::timeout(Duration::from_secs(5), stale)
+            .await
+            .expect("the session handles the stale response");
+        assert!(stale.is_err(), "a response for a previous channel was handled");
+
+        let (completion, handled) = oneshot::channel();
+        input
+            .send_clipboard_for_instance(current, response(b"CNDF"), completion)
+            .expect("the session is running");
+        tokio::time::timeout(Duration::from_secs(10), handled)
+            .await
+            .expect("the session handles the current response")
+            .expect("the session signals the written response");
+        let received = tokio::time::timeout(Duration::from_secs(10), responses.recv())
+            .await
+            .expect("the server receives the response")
+            .expect("the server clipboard reports the response");
+        assert_eq!(received, (7, Some(b"CNDF".to_vec())));
+        assert!(responses.try_recv().is_err());
+
+        input.request_close();
+        let _ = tokio::time::timeout(Duration::from_secs(5), client_task).await;
+        events.abort();
+        server_task.abort();
+    }))
+    .await;
+}
