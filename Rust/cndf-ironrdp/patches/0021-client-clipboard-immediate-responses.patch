+++ b/crates/ironrdp-testsuite-core/tests/clipboard/immediate_responses.rs
@@ -0,0 +1,146 @@
+//! Tests for backend answers returned with the output of the PDU that carried the request.
+
+use std::sync::{Arc, Mutex};
+
+use ironrdp_cliprdr::backend::CliprdrBackend;
+use ironrdp_cliprdr::pdu::{
+    ClipboardFormat, ClipboardFormatId, ClipboardGeneralCapabilityFlags, ClipboardPdu, FileContentsFlags,
+    FileContentsRequest, FileContentsResponse, FileDescriptor, FormatDataRequest, FormatDataResponse, LockDataId,
+    OwnedFormatDataResponse,
+};
+use ironrdp_cliprdr::{CliprdrClient, CliprdrInstance};
+use ironrdp_core::{AsAny, encode_vec};
+use ironrdp_svc::{SvcMessage, SvcProcessor as _};
+use ironrdp_testsuite_core::clipboard::{TestBackend, init_ready_client_with_backend, real_now_ms};
+
+#[derive(Debug, Default)]
+struct Calls {
+    deferred_file_requests: Vec<u32>,
+    deferred_format_requests: usize,
+    instances: Vec<CliprdrInstance>,
+}
+
+/// Answers file contents requests with a failure and text requests with fixed data, at once.
+#[derive(Debug)]
+struct AnsweringBackend(Arc<Mutex<Calls>>);
+
+impl AsAny for AnsweringBackend {
+    fn as_any(&self) -> &dyn core::any::Any {
+        self
+    }
+    fn as_any_mut(&mut self) -> &mut dyn core::any::Any {
+        self
+    }
+}
+
+impl CliprdrBackend for AnsweringBackend {
+    fn temporary_directory(&self) -> &str {
+        "/tmp"
+    }
+    fn client_capabilities(&self) -> ClipboardGeneralCapabilityFlags {
+        ClipboardGeneralCapabilityFlags::STREAM_FILECLIP_ENABLED
+    }
+    fn on_ready(&mut self) {}
+    fn on_request_format_list(&mut self) {}
+    fn on_process_negotiated_capabilities(&mut self, _: ClipboardGeneralCapabilityFlags) {}
+    fn on_remote_copy(&mut self, _: &[ClipboardFormat]) {}
+    fn on_format_data_request(&mut self, _: FormatDataRequest) {
+        self.0.lock().unwrap().deferred_format_requests += 1;
+    }
+    fn respond_to_format_data_request(&mut self, _: FormatDataRequest) -> Option<OwnedFormatDataResponse> {
+        Some(FormatDataResponse::new_data(b"a\0\0\0".to_vec()))
+    }
+    fn on_format_data_response(&mut self, _: FormatDataResponse<'_>) {}
+    fn on_file_contents_request(&mut self, request: FileContentsRequest) {
+        self.0.lock().unwrap().deferred_file_requests.push(request.stream_id);
+    }
+    fn respond_to_file_contents_request(
+        &mut self,
+        request: FileContentsRequest,
+        instance: CliprdrInstance,
+    ) -> Option<FileContentsResponse<'static>> {
+        self.0.lock().unwrap().instances.push(instance);
+        Some(FileContentsResponse::new_error(request.stream_id))
+    }
+    fn on_file_contents_response(&mut self, _: FileContentsResponse<'_>) {}
+    fn on_lock(&mut self, _: LockDataId) {}
+    fn on_unlock(&mut self, _: LockDataId) {}
+    fn now_ms(&self) -> u64 {
+        real_now_ms()
+    }
+}
+
+fn offering_client(backend: Box<dyn CliprdrBackend>) -> CliprdrClient {
+    let mut cliprdr = init_ready_client_with_backend(backend);
+    cliprdr
+        .initiate_file_copy(vec![FileDescriptor::new("file.bin").with_file_size(4)])
+        .unwrap();
+    cliprdr
+}
+
+fn range(stream_id: u32) -> Vec<u8> {
+    encode_vec(&ClipboardPdu::FileContentsRequest(FileContentsRequest {
+        stream_id,
+        index: 0,
+        flags: FileContentsFlags::RANGE,
+        position: 0,
+        requested_size: 4,
+        data_id: None,
+    }))
+    .unwrap()
+}
+
+fn decoded(messages: &[SvcMessage]) -> Vec<Vec<u8>> {
+    messages
+        .iter()
+        .map(|message| message.encode_unframed_pdu().unwrap())
+        .collect()
+}
+
+// oracle: mutant dropping the backend's answer, or calling the deferred callback as well.
+#[test]
+fn backend_answers_are_returned_with_the_request_output() {
+    let calls = Arc::new(Mutex::new(Calls::default()));
+    let mut cliprdr = offering_client(Box::new(AnsweringBackend(Arc::clone(&calls))));
+
+    let output = decoded(&cliprdr.process(&range(7)).unwrap());
+    assert_eq!(output.len(), 1);
+    let ClipboardPdu::FileContentsResponse(response) = ironrdp_core::decode::<ClipboardPdu<'_>>(&output[0]).unwrap()
+    else {
+        panic!("expected a file contents response");
+    };
+    assert_eq!((response.stream_id(), response.is_error()), (7, true));
+
+    let text = encode_vec(&ClipboardPdu::FormatDataRequest(FormatDataRequest {
+        format: ClipboardFormatId::CF_UNICODETEXT,
+    }))
+    .unwrap();
+    let output = decoded(&cliprdr.process(&text).unwrap());
+    assert_eq!(output.len(), 1);
+    let ClipboardPdu::FormatDataResponse(response) = ironrdp_core::decode::<ClipboardPdu<'_>>(&output[0]).unwrap()
+    else {
+        panic!("expected a format data response");
+    };
+    assert_eq!(response.data(), b"a\0\0\0");
+
+    let calls = calls.lock().unwrap();
+    assert!(calls.deferred_file_requests.is_empty());
+    assert_eq!(calls.deferred_format_requests, 0);
+    assert_eq!(calls.instances, [cliprdr.instance()]);
+}
+
+// oracle: mutant answering on behalf of a backend that defers, or skipping its callback.
+#[test]
+fn default_backends_still_answer_later() {
+    let mut cliprdr = offering_client(Box::new(TestBackend));
+    assert!(cliprdr.process(&range(7)).unwrap().is_empty());
+}
+
+// oracle: mutant sharing an instance between processors.
+#[test]
+fn each_processor_has_its_own_instance() {
+    let first = CliprdrClient::new(Box::new(TestBackend));
+    let second = CliprdrClient::new(Box::new(TestBackend));
+    assert_eq!(first.instance(), first.instance());
+    assert_ne!(first.instance(), second.instance());
+}
