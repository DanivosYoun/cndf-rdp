+//! Bytes the Fast-Path processor keeps after hostile server input.
+//!
+//! The global allocator counts bytes per thread, so each test measures only its own allocations
+//! even when the test harness runs tests in parallel.
+
+#![allow(unused_crate_dependencies)]
+#![allow(clippy::unwrap_used)]
+
+use std::alloc::{GlobalAlloc, Layout, System};
+use std::cell::Cell;
+
+use ironrdp_bulk::{BulkCompressor, CompressionType as BulkType, flags};
+use ironrdp_core::{WriteBuf, encode_vec};
+use ironrdp_graphics::image_processing::PixelFormat;
+use ironrdp_pdu::bitmap::{BitmapData, BitmapUpdateData, Compression};
+use ironrdp_pdu::fast_path::{EncryptionFlags, FastPathHeader, FastPathUpdatePdu, Fragmentation, UpdateCode};
+use ironrdp_pdu::geometry::InclusiveRectangle;
+use ironrdp_pdu::pointer::{LargePointerAttribute, Point16};
+use ironrdp_pdu::rdp::client_info::CompressionType;
+use ironrdp_pdu::rdp::headers::CompressionFlags;
+use ironrdp_session::fast_path::{MAX_FRAGMENTED_UPDATE_SIZE, Processor, ProcessorBuilder, UpdateKind};
+use ironrdp_session::image::DecodedImage;
+
+const MIB: usize = 1024 * 1024;
+
+thread_local! {
+    static HELD: Cell<isize> = const { Cell::new(0) };
+}
+
+fn track(delta: isize) {
+    let _ = HELD.try_with(|held| held.set(held.get() + delta));
+}
+
+fn held() -> isize {
+    HELD.with(Cell::get)
+}
+
+struct ThreadCountingAllocator;
+
+#[global_allocator]
+static ALLOCATOR: ThreadCountingAllocator = ThreadCountingAllocator;
+
+fn signed(size: usize) -> isize {
+    isize::try_from(size).unwrap_or(isize::MAX)
+}
+
+// SAFETY: every method forwards to `System` with the caller's arguments and only adds bookkeeping.
+unsafe impl GlobalAlloc for ThreadCountingAllocator {
+    unsafe fn alloc(&self, layout: Layout) -> *mut u8 {
+        // SAFETY: forwarded with the caller's layout.
+        let ptr = unsafe { System.alloc(layout) };
+        if !ptr.is_null() {
+            track(signed(layout.size()));
+        }
+        ptr
+    }
+
+    unsafe fn alloc_zeroed(&self, layout: Layout) -> *mut u8 {
+        // SAFETY: forwarded with the caller's layout.
+        let ptr = unsafe { System.alloc_zeroed(layout) };
+        if !ptr.is_null() {
+            track(signed(layout.size()));
+        }
+        ptr
+    }
+
+    unsafe fn dealloc(&self, ptr: *mut u8, layout: Layout) {
+        // SAFETY: forwarded with the caller's pointer and layout.
+        unsafe { System.dealloc(ptr, layout) };
+        track(-signed(layout.size()));
+    }
+
+    unsafe fn realloc(&self, ptr: *mut u8, layout: Layout, new_size: usize) -> *mut u8 {
+        // SAFETY: forwarded with the caller's pointer, layout and size.
+        let new_ptr = unsafe { System.realloc(ptr, layout, new_size) };
+        if !new_ptr.is_null() {
+            track(signed(new_size) - signed(layout.size()));
+        }
+        new_ptr
+    }
+}
+
+fn processor(enable_server_pointer: bool) -> Processor {
+    ProcessorBuilder {
+        io_channel_id: 1003,
+        user_channel_id: 1002,
+        share_id: 0x10000,
+        enable_server_pointer,
+        pointer_software_rendering: false,
+    }
+    .build()
+}
+
+fn update(fragmentation: Fragmentation, update_code: UpdateCode, data: &[u8], bulk_flags: Option<u32>) -> Vec<u8> {
+    let (compression_flags, compression_type) = match bulk_flags {
+        Some(bulk_flags) if bulk_flags & flags::PACKET_COMPRESSED != 0 => (
+            Some(CompressionFlags::from_bits_retain(
+                u8::try_from(bulk_flags & 0xE0).unwrap(),
+            )),
+            Some(CompressionType::K64),
+        ),
+        _ => (None, None),
+    };
+    encode_vec(&FastPathUpdatePdu {
+        fragmentation,
+        update_code,
+        compression_flags,
+        compression_type,
+        data,
+    })
+    .unwrap()
+}
+
+/// Packs updates into Fast-Path PDUs no longer than 0x7FFF bytes.
+fn pack(updates: &[Vec<u8>]) -> Vec<Vec<u8>> {
+    let mut pdus = Vec::new();
+    let mut body = Vec::new();
+    let flush = |body: &mut Vec<u8>, pdus: &mut Vec<Vec<u8>>| {
+        if !body.is_empty() {
+            let mut pdu = encode_vec(&FastPathHeader::new(EncryptionFlags::empty(), body.len())).unwrap();
+            pdu.append(body);
+            assert!(pdu.len() <= 0x7FFF);
+            pdus.push(pdu);
+        }
+    };
+    for update in updates {
+        if body.len() + update.len() + 3 > 0x7FFF {
+            flush(&mut body, &mut pdus);
+        }
+        body.extend_from_slice(update);
+    }
+    flush(&mut body, &mut pdus);
+    pdus
+}
