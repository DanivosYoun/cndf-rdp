+/// Design 0ba44ae2, first falsification point of patch 0023: about 0.7 MiB of MPPC-compressed Next
+/// fragments must not make the processor hold more than 16 MiB, and the next normal bitmap must decode.
+#[test]
+fn mppc_next_fragment_flood_stays_within_the_advertised_request_size() {
+    let mut processor = processor(true);
+    let mut image = DecodedImage::new(PixelFormat::RgbA32, 64, 64);
+    let mut client_bulk = Some(BulkCompressor::new(BulkType::Rdp5));
+    let mut server_bulk = BulkCompressor::new(BulkType::Rdp5);
+    let mut output = WriteBuf::new();
+    let zeros = vec![0u8; 16_000];
+    let mut compressed = |fragmentation| {
+        let (size, bulk_flags) = server_bulk.compress(&zeros).unwrap();
+        let data = server_bulk.compressed_data(size).to_vec();
+        update(fragmentation, UpdateCode::Bitmap, &data, Some(bulk_flags))
+    };
+
+    let base = held();
+    let mut wire = 0;
+    let mut reassembled = 0;
+    let mut max_held = 0;
+    let mut batch = vec![compressed(Fragmentation::First)];
+    while wire < 700 * 1024 {
+        while batch.len() < 256 {
+            batch.push(compressed(Fragmentation::Next));
+        }
+        for pdu in pack(&batch) {
+            wire += pdu.len();
+            processor
+                .process(&mut image, &pdu, &mut output, &mut client_bulk)
+                .expect("a hostile fragment flood must not fail the session");
+        }
+        reassembled += batch.len() * zeros.len();
+        batch.clear();
+        max_held = max_held.max(held() - base);
+    }
+    let held_after = held() - base;
+    println!(
+        "mppc flood: wire={wire} B reassembled={} MiB held={held_after} B max_held={max_held} B",
+        reassembled / MIB
+    );
+    assert!(reassembled > 100 * MAX_FRAGMENTED_UPDATE_SIZE, "the flood exceeds the limit many times over");
+    assert!(
+        max_held <= signed(16 * MIB),
+        "processor held {max_held} bytes after {wire} wire bytes"
+    );
+
+    // Two bottom-up BGR rows of two pixels each, with two pad bytes per row.
+    let bitmap_data = [3, 2, 1, 6, 5, 4, 0, 0, 9, 8, 7, 12, 11, 10, 0, 0];
+    let bitmap = encode_vec(&BitmapUpdateData {
+        rectangles: vec![BitmapData {
+            rectangle: InclusiveRectangle {
+                left: 0,
+                top: 0,
+                right: 1,
+                bottom: 1,
+            },
+            width: 2,
+            height: 2,
+            bits_per_pixel: 24,
+            compression_flags: Compression::empty(),
+            compressed_data_header: None,
+            bitmap_data: &bitmap_data,
+        }],
+    })
+    .unwrap();
+    let single = pack(&[update(Fragmentation::Single, UpdateCode::Bitmap, &bitmap, None)]);
+    let updates = processor
+        .process(&mut image, &single[0], &mut output, &mut client_bulk)
+        .expect("normal bitmap after the flood");
+    assert!(matches!(updates.as_slice(), [UpdateKind::Region(_)]), "{updates:?}");
+    assert_eq!(image.data()[..4], [7, 8, 9, 255]);
+}
