+/// 1024 Large pointers of 384x384 must leave at most the 32 advertised cache entries behind.
+#[test]
+fn large_pointer_flood_keeps_only_the_advertised_cache_entries() {
+    let mut processor = processor(true);
+    let mut image = DecodedImage::new(PixelFormat::RgbA32, 64, 64);
+    let mut client_bulk = None;
+    let mut output = WriteBuf::new();
+    let edge = 384u16;
+    let mask = vec![0u8; usize::from(edge).div_ceil(16) * 2 * usize::from(edge)];
+
+    let base = held();
+    let mut wire = 0;
+    for cache_index in 0..1024u16 {
+        let attribute = encode_vec(&LargePointerAttribute {
+            xor_bpp: 1,
+            cache_index,
+            hot_spot: Point16 { x: 0, y: 0 },
+            width: edge,
+            height: edge,
+            xor_mask: &mask,
+            and_mask: &mask,
+        })
+        .unwrap();
+        let pieces: Vec<&[u8]> = attribute.chunks(30_000).collect();
+        for (index, piece) in pieces.iter().enumerate() {
+            let fragmentation = match index {
+                0 => Fragmentation::First,
+                index if index + 1 == pieces.len() => Fragmentation::Last,
+                _ => Fragmentation::Next,
+            };
+            for pdu in pack(&[update(fragmentation, UpdateCode::LargePointer, piece, None)]) {
+                wire += pdu.len();
+                let updates = processor
+                    .process(&mut image, &pdu, &mut output, &mut client_bulk)
+                    .expect("pointer updates must not fail the session");
+                if fragmentation == Fragmentation::Last && cache_index >= 32 {
+                    assert!(matches!(updates.as_slice(), [UpdateKind::PointerDefault]), "{updates:?}");
+                }
+            }
+        }
+    }
+    let held_after = held() - base;
+    println!("pointer flood: wire={wire} B held={held_after} B");
+    // Each decoded 384x384 shape keeps a 1 MiB buffer; 64 KiB covers the cache map and `Arc` headers.
+    assert!(
+        held_after <= signed(32 * MIB + 64 * 1024),
+        "processor held {held_after} bytes after {wire} wire bytes"
+    );
+}
