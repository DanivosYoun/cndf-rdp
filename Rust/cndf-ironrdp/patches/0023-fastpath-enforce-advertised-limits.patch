+// oracle: patch 0023 enforces the limits this client advertises, so the Fast-Path constants must equal
+// the Client Confirm Active values the connector sends when the server leaves them to the client.
+#[test]
+fn client_confirm_active_advertises_the_fast_path_enforced_limits() {
+    use ironrdp_pdu::rdp::capability_sets::LargePointerSupportFlags;
+    use ironrdp_session::fast_path::{
+        MAX_COLOR_POINTER_EDGE, MAX_FRAGMENTED_UPDATE_SIZE, MAX_LARGE_POINTER_EDGE, POINTER_CACHE_SIZE,
+    };
+
+    let mut demand_active = SERVER_DEMAND_ACTIVE.clone();
+    demand_active
+        .pdu
+        .capability_sets
+        .retain(|capability_set| !matches!(capability_set, CapabilitySet::MultiFragmentUpdate(_)));
+    let mut sequence = ConnectionActivationSequence::new(test_config(), IO_CHANNEL_ID, USER_CHANNEL_ID);
+    let mut output = WriteBuf::new();
+    let frame = encode_server_share_control(ShareControlPdu::ServerDemandActive(demand_active));
+    sequence
+        .step(&frame, None, &mut output)
+        .expect("demand active should be accepted");
+
+    let X224(McsMessage::SendDataRequest(request)) = decode(output.filled()).unwrap() else {
+        panic!("the client confirm active must be written");
+    };
+    let header: ShareControlHeader = decode(&request.user_data).unwrap();
+    let ShareControlPdu::ClientConfirmActive(confirm) = header.share_control_pdu else {
+        panic!("expected a client confirm active");
+    };
+    let capability_sets = &confirm.pdu.capability_sets;
+
+    let pointer = capability_sets
+        .iter()
+        .find_map(|capability_set| match capability_set {
+            CapabilitySet::Pointer(pointer) => Some(pointer),
+            _ => None,
+        })
+        .expect("pointer capability");
+    assert_eq!(pointer.color_pointer_cache_size, POINTER_CACHE_SIZE);
+    assert_eq!(pointer.pointer_cache_size, POINTER_CACHE_SIZE);
+
+    let large_pointer = capability_sets
+        .iter()
+        .find_map(|capability_set| match capability_set {
+            CapabilitySet::LargePointer(large_pointer) => Some(large_pointer.flags),
+            _ => None,
+        })
+        .expect("large pointer capability");
+    assert_eq!(
+        large_pointer,
+        LargePointerSupportFlags::UP_TO_96X96_PIXELS | LargePointerSupportFlags::UP_TO_384X384_PIXELS
+    );
+    assert_eq!((MAX_COLOR_POINTER_EDGE, MAX_LARGE_POINTER_EDGE), (96, 384));
+
+    let max_request_size = capability_sets
+        .iter()
+        .find_map(|capability_set| match capability_set {
+            CapabilitySet::MultiFragmentUpdate(update) => Some(update.max_request_size),
+            _ => None,
+        })
+        .expect("multifragment update capability");
+    assert_eq!(usize::try_from(max_request_size).unwrap(), MAX_FRAGMENTED_UPDATE_SIZE);
+}
