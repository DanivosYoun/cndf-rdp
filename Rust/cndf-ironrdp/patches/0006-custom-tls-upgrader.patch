 // ── Shared security upgrade + finalize ────────────────────────────────────────
 
+type ErasedTlsUpgrade = (Box<dyn AsyncReadWrite + Unpin + Send + Sync>, x509_cert::Certificate);
+
+fn erase_tls_stream<T>((stream, cert): (T, x509_cert::Certificate)) -> ErasedTlsUpgrade
+where
+    T: AsyncRead + AsyncWrite + Unpin + Send + Sync + 'static,
+{
+    (Box::new(stream), cert)
+}
+
+/// Runs a [`crate::config::TlsUpgrader`] and decodes the leaf of the chain it returns.
+async fn custom_tls_upgrade<S>(
+    upgrader: &dyn crate::config::TlsUpgrader,
+    stream: S,
+    config: &Config,
+) -> io::Result<ErasedTlsUpgrade>
+where
+    S: AsyncRead + AsyncWrite + Unpin + Send + Sync + 'static,
+{
+    use x509_cert::der::Decode as _;
+
+    let (stream, chain, _negotiated) = upgrader
+        .upgrade(Box::new(stream), config.destination.name().to_owned(), config.destination.to_string())
+        .await?;
+    let leaf = chain
+        .first()
+        .ok_or_else(|| io::Error::other("TLS upgrader returned no peer certificate"))?;
+    let cert = x509_cert::Certificate::from_der(leaf).map_err(io::Error::other)?;
+    Ok((Box::new(stream), cert))
+}
