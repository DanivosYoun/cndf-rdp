+/// Relays one connection to `server`, and stops reading from the client while `paused` is set, so the client's
+/// socket writes block once the socket buffers fill.
+async fn pausable_proxy(server: SocketAddr, mut paused: tokio::sync::watch::Receiver<bool>) -> SocketAddr {
+    use tokio::io::{AsyncReadExt as _, AsyncWriteExt as _};
+
+    let socket = tokio::net::TcpSocket::new_v4().expect("socket");
+    socket.set_recv_buffer_size(4096).expect("SO_RCVBUF");
+    socket.bind((Ipv4Addr::LOCALHOST, 0).into()).expect("bind");
+    let listener = socket.listen(1).expect("listen");
+    let address = listener.local_addr().expect("proxy address");
+    tokio::task::spawn_local(async move {
+        let (client, _) = listener.accept().await.expect("the client connects");
+        let upstream = TcpStream::connect(server).await.expect("the server accepts");
+        let (mut client_read, mut client_write) = client.into_split();
+        let (mut upstream_read, mut upstream_write) = upstream.into_split();
+        let down = async move {
+            let _ = tokio::io::copy(&mut upstream_read, &mut client_write).await;
+            let _ = client_write.shutdown().await;
+        };
+        let up = async move {
+            let mut buffer = vec![0; 64 * 1024];
+            loop {
+                while *paused.borrow_and_update() {
+                    if paused.changed().await.is_err() {
+                        return;
+                    }
+                }
+                let read = match client_read.read(&mut buffer).await {
+                    Ok(0) | Err(_) => break,
+                    Ok(read) => read,
+                };
+                if upstream_write.write_all(&buffer[..read]).await.is_err() {
+                    break;
+                }
+            }
+            let _ = upstream_write.shutdown().await;
+        };
+        tokio::join!(down, up);
+    });
+    address
+}
