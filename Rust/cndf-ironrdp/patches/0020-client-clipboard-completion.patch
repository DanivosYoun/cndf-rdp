+/// Connects an `RdpClient` with a clipboard channel to a cliprdr server through [`pausable_proxy`], and runs `test`
+/// once the clipboard channel is ready.
+async fn with_ready_client_clipboard<F>(
+    test: impl FnOnce(
+        ironrdp_client::rdp::RdpInputSender,
+        tokio::sync::watch::Sender<bool>,
+        tokio::task::JoinHandle<()>,
+    ) -> F,
+) where
+    F: Future<Output = ()>,
+{
+    use ironrdp_client::rdp::{RdpClient, RdpOutputEvent};
+
+    let identity = test_tls_identity();
+    let acceptor = identity.make_acceptor().expect("failed to build TLS acceptor");
+    let (_display_tx, display_rx) = mpsc::unbounded_channel();
+    let mut server = RdpServer::builder()
+        .with_addr(([127, 0, 0, 1], 0))
+        .with_hybrid(acceptor, identity.pub_key)
+        .with_input_handler(TestInputHandler)
+        .with_display_handler(TestDisplay {
+            rx: Arc::new(Mutex::new(display_rx)),
+            offers_display_control: true,
+        })
+        .with_cliprdr_factory(Some(Box::new(NoClipboardFactory)))
+        .build();
+    server.set_credentials(Some(server::Credentials {
+        username: HYBRID_USER.into(),
+        password: HYBRID_PASSWORD.into(),
+        domain: None,
+    }));
+    let handle = server.handle().clone();
+    let local = tokio::task::LocalSet::new();
+    Box::pin(local.run_until(async move {
+        let server_task = tokio::task::spawn_local(async move {
+            let _ = server.run().await;
+        });
+        let server_address = handle.local_addr().await.unwrap().unwrap();
+        let (pause, paused) = tokio::sync::watch::channel(false);
+        let proxy_address = pausable_proxy(server_address, paused).await;
+        let config = ironrdp_client::config::ConfigBuilder::new()
+            .with_destination(ironrdp_client::config::Destination::from_parts(
+                "127.0.0.1",
+                proxy_address.port(),
+            ))
+            .with_username(HYBRID_USER)
+            .with_password(HYBRID_PASSWORD)
+            .with_credssp(true)
+            .with_client_build(1)
+            .with_client_dir("C:\\")
+            .with_platform(MajorPlatformType::WINDOWS)
+            .with_client_name("client")
+            .with_clipboard(ironrdp_client::config::ClipboardType::Enable)
+            .build()
+            .expect("client configuration");
+        let (output_tx, mut output_rx) = ironrdp_client::output_channel::output_channel(64);
+        let client = RdpClient::new(config, output_tx);
+        let input = client.input_sender();
+        let (ready_tx, ready_rx) = oneshot::channel();
+        let client = client.with_cliprdr_backend_factory(Box::new(ReadyClipboardFactory {
+            input: input.clone(),
+            ready: StdMutex::new(Some(ready_tx)),
+        }));
+        let client_task = tokio::task::spawn_local(client.run());
+        let events = tokio::task::spawn_local(async move {
+            while let Some(event) = output_rx.recv().await {
+                assert!(
+                    !matches!(event, RdpOutputEvent::ConnectionFailure(_)),
+                    "the client failed: {event:?}"
+                );
+            }
+        });
+        tokio::time::timeout(Duration::from_secs(20), ready_rx)
+            .await
+            .expect("the clipboard channel becomes ready in time")
+            .expect("the clipboard channel becomes ready");
+        test(input, pause, client_task).await;
+        events.abort();
+        server_task.abort();
+    }))
+    .await;
+}
