+/// A clipboard message larger than what the socket buffers on both sides of the proxy hold.
+fn large_file_contents_response() -> ironrdp::cliprdr::backend::ClipboardMessage {
+    ironrdp::cliprdr::backend::ClipboardMessage::SendFileContentsResponse(
+        ironrdp::cliprdr::pdu::FileContentsResponse::new_data_response(1, vec![0x5A; 16 * 1024 * 1024]),
+    )
+}
+
+/// The completion of a clipboard message stays pending while its frame cannot be written, and is signaled
+/// once the write finishes.
+// oracle: mutant signaling the completion before the iteration's frames are written
+#[tokio::test]
+async fn client_clipboard_completion_waits_for_a_blocked_write() {
+    with_ready_client_clipboard(|input, pause, client_task| async move {
+        pause.send(true).unwrap();
+        let (completion, mut handled) = oneshot::channel();
+        input
+            .send_clipboard_with_completion(large_file_contents_response(), completion)
+            .expect("the session is running");
+        tokio::time::sleep(Duration::from_millis(500)).await;
+        assert_eq!(
+            handled.try_recv(),
+            Err(oneshot::error::TryRecvError::Empty),
+            "the completion was signaled before the frame was written"
+        );
+        pause.send(false).unwrap();
+        tokio::time::timeout(Duration::from_secs(10), handled)
+            .await
+            .expect("the completion arrives once the write finishes")
+            .expect("the session signals rather than drops the completion");
+        input.request_close();
+        let _ = tokio::time::timeout(Duration::from_secs(5), client_task).await;
+    })
+    .await;
+}
+
+/// Closing the session while a clipboard frame is blocked drops its completion without signaling it.
+// oracle: mutant signaling the completion when the blocked write is canceled, or keeping it after the session ends
+#[tokio::test]
+async fn client_clipboard_completion_closes_when_the_session_ends() {
+    with_ready_client_clipboard(|input, pause, client_task| async move {
+        pause.send(true).unwrap();
+        let (completion, mut handled) = oneshot::channel();
+        input
+            .send_clipboard_with_completion(large_file_contents_response(), completion)
+            .expect("the session is running");
+        tokio::time::sleep(Duration::from_millis(500)).await;
+        assert_eq!(handled.try_recv(), Err(oneshot::error::TryRecvError::Empty));
+        input.request_close();
+        let closed = tokio::time::timeout(Duration::from_secs(2), handled)
+            .await
+            .expect("the completion closes when the session ends");
+        assert!(closed.is_err(), "the completion was signaled for an unwritten frame");
+        tokio::time::timeout(Duration::from_secs(2), client_task)
+            .await
+            .expect("the client stops")
+            .unwrap();
+        drop(pause);
+    })
+    .await;
+}
