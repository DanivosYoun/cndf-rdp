+
+/// A graceful close with the budget spent skips a desktop update. From then on the session sends
+/// no desktop update, even once the consumer resumes, so no later frame end can mark a
+/// framebuffer that lacks the skipped one; the shutdown still completes and every permit returns.
+#[test]
+fn graceful_skip_ends_desktop_updates_for_the_session() {
+    run_local(|| async {
+        let (probe_tx, probe_rx) = oneshot::channel();
+        let mut session = start(1024, 1024, vec![Step::Frame; 60], 128, Some(probe_tx)).await;
+        let probe = probe_rx.await.unwrap();
+        let base = CURRENT.load(Ordering::Relaxed);
+        session.stall(60, base).await;
+        let queued = probe.__test_desktop_update_bytes_in_flight();
+        assert!(queued > 24 * MIB, "{queued} bytes queued: the budget is not spent");
+        session.input.request_graceful_close();
+        // The session loop takes the request and skips while nothing is consumed.
+        tokio::time::sleep(Duration::from_millis(1)).await;
+        let mut received = 0;
+        let mut updates = 0;
+        tokio::time::timeout(Duration::from_secs(10), async {
+            loop {
+                match session.output.recv().await.expect("the client is running") {
+                    RdpOutputEvent::DesktopUpdate(update) => {
+                        received += update.buffer().len() * 4;
+                        updates += 1;
+                    }
+                    RdpOutputEvent::Terminated(_) => return,
+                    _ => {}
+                }
+            }
+        })
+        .await
+        .expect("the session terminates");
+        println!("queued={} received={} updates={updates}", mib(queued), mib(received));
+        assert_eq!(received, queued, "desktop updates were sent after one was skipped");
+        tokio::time::timeout(Duration::from_secs(5), &mut session.client)
+            .await
+            .expect("the client ends")
+            .unwrap();
+        assert_eq!(probe.__test_desktop_update_bytes_in_flight(), 0, "a permit was not returned");
+        session.server.abort();
+    });
+}
