+/// Default cap on the progressive state a [`ProgressiveDecoder`] keeps across payloads:
+/// tile grids, tiles and sub-band references together.
+///
+/// One tile holds about 61 KiB here (its [`TileState`] plus its sub-band reference), so a
+/// 3840x2160 surface fully refined holds about 120 MiB and two of them stay well inside the cap.
+/// The surface dimension cap alone does not bound this state: every surface the server creates
+/// gets its own grid and tiles.
+pub const DEFAULT_STATE_BUDGET: usize = 512 * 1024 * 1024;
+
+const GRID_SLOT_BYTES: usize = size_of::<Option<Box<TileState>>>();
+const TILE_STATE_BYTES: usize = size_of::<TileState>();
+/// A boxed sub-band reference plus a generous share of its map node (key and box pointer).
+const REFERENCE_BYTES: usize = size_of::<DecDwtQ>() + 64;
+
+fn grid_bytes(surface_width: u16, surface_height: u16) -> usize {
+    usize::from(surface_width.div_ceil(TILE_DIM)) * usize::from(surface_height.div_ceil(TILE_DIM)) * GRID_SLOT_BYTES
+}
+
+/// Running total of the progressive state bytes a decoder holds, against its budget.
+struct StateBytes {
+    held: usize,
+    budget: usize,
+}
+
+impl StateBytes {
+    /// Fail unless `bytes` more fit in the budget; checked before the allocation it covers.
+    fn ensure(&self, bytes: usize) -> Result<(), ProgressiveDecodeError> {
+        match self.held.checked_add(bytes) {
+            Some(total) if total <= self.budget => Ok(()),
+            _ => Err(ProgressiveDecodeError::StateBudget {
+                requested: bytes,
+                held: self.held,
+                budget: self.budget,
+            }),
+        }
+    }
+
+    /// Record an allocation that [`Self::ensure`] admitted.
+    fn charge(&mut self, bytes: usize) {
+        self.held += bytes;
+    }
+
+    fn release(&mut self, bytes: usize) {
+        self.held = self.held.saturating_sub(bytes);
+    }
+}
