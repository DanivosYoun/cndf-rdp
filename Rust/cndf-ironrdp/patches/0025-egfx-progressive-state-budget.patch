diff --git a/crates/ironrdp-graphics/tests/progressive_state_budget.rs b/crates/ironrdp-graphics/tests/progressive_state_budget.rs
new file mode 100644
index 00000000..2d2749af
--- /dev/null
+++ b/crates/ironrdp-graphics/tests/progressive_state_budget.rs
@@ -0,0 +1,303 @@
+//! Bytes a [`ProgressiveDecoder`] keeps across payloads stay inside its state budget.
+//!
+//! A counting allocator measures what the decoder actually holds, so these run in their own test
+//! binary and take a lock to keep the measurements of one test out of another's.
+
+#![expect(unused_crate_dependencies, reason = "an integration test uses a few of the crate's dependencies")]
+#![expect(
+    clippy::unwrap_used,
+    clippy::panic,
+    clippy::print_stderr,
+    reason = "test helpers fail loudly and report the bytes they measured"
+)]
+
+use core::alloc::{GlobalAlloc, Layout};
+use core::sync::atomic::{AtomicUsize, Ordering::Relaxed};
+use std::alloc::System;
+use std::sync::Mutex;
+
+use ironrdp_graphics::progressive::{
+    COEFFICIENTS_PER_COMPONENT, DEFAULT_STATE_BUDGET, ProgressiveDecodeError, ProgressiveDecoder, encode_first_pass,
+};
+use ironrdp_pdu::codecs::rfx::RfxRectangle;
+use ironrdp_pdu::codecs::rfx::progressive::{
+    ComponentCodecQuant, ProgressiveBlock, ProgressiveContextPdu, ProgressiveFrameBeginPdu, ProgressiveFrameEndPdu,
+    ProgressiveRegion, ProgressiveSyncPdu, ProgressiveTile, TileSimple, TileUpgrade, encode_progressive_stream,
+};
+
+struct Counting;
+
+static HELD: AtomicUsize = AtomicUsize::new(0);
+
+// SAFETY: forwards every call to `System` and only counts the sizes it allocated.
+unsafe impl GlobalAlloc for Counting {
+    unsafe fn alloc(&self, layout: Layout) -> *mut u8 {
+        // SAFETY: same contract as the caller's.
+        let ptr = unsafe { System.alloc(layout) };
+        if !ptr.is_null() {
+            HELD.fetch_add(layout.size(), Relaxed);
+        }
+        ptr
+    }
+
+    unsafe fn alloc_zeroed(&self, layout: Layout) -> *mut u8 {
+        // SAFETY: same contract as the caller's.
+        let ptr = unsafe { System.alloc_zeroed(layout) };
+        if !ptr.is_null() {
+            HELD.fetch_add(layout.size(), Relaxed);
+        }
+        ptr
+    }
+
+    unsafe fn dealloc(&self, ptr: *mut u8, layout: Layout) {
+        // SAFETY: same contract as the caller's.
+        unsafe { System.dealloc(ptr, layout) };
+        HELD.fetch_sub(layout.size(), Relaxed);
+    }
+
+    unsafe fn realloc(&self, ptr: *mut u8, layout: Layout, new_size: usize) -> *mut u8 {
+        // SAFETY: same contract as the caller's.
+        let new = unsafe { System.realloc(ptr, layout, new_size) };
+        if !new.is_null() {
+            HELD.fetch_sub(layout.size(), Relaxed);
+            HELD.fetch_add(new_size, Relaxed);
+        }
+        new
+    }
+}
+
+#[global_allocator]
+static ALLOCATOR: Counting = Counting;
+
+static SERIAL: Mutex<()> = Mutex::new(());
+
+const MIB: usize = 1024 * 1024;
+const TEST_BUDGET: usize = 8 * MIB;
+/// Room for allocator bookkeeping the decoder does not own, such as the frame tile set.
+const SLACK: usize = MIB;
+
+fn held() -> usize {
+    HELD.load(Relaxed)
+}
+
+fn zero_component() -> Vec<u8> {
+    let mut coefficients = [0i16; COEFFICIENTS_PER_COMPONENT];
+    let mut data = [0u8; 8192];
+    let len = encode_first_pass(
+        &mut coefficients,
+        &mut data,
+        &ComponentCodecQuant::LOSSLESS,
+        &ComponentCodecQuant::LOSSLESS,
+        false,
+    )
+    .unwrap();
+    data[..len].to_vec()
+}
+
+fn simple(component: &[u8], x_idx: u16, y_idx: u16) -> ProgressiveTile<'_> {
+    ProgressiveTile::Simple(TileSimple {
+        quant_idx_y: 0,
+        quant_idx_cb: 0,
+        quant_idx_cr: 0,
+        x_idx,
+        y_idx,
+        flags: 0,
+        y_data: component,
+        cb_data: component,
+        cr_data: component,
+        tail_data: &[],
+    })
+}
+
+fn upgrade(x_idx: u16, y_idx: u16) -> ProgressiveTile<'static> {
+    ProgressiveTile::Upgrade(TileUpgrade {
+        quant_idx_y: 0,
+        quant_idx_cb: 0,
+        quant_idx_cr: 0,
+        x_idx,
+        y_idx,
+        quality: 0xFF,
+        y_srl_data: &[],
+        y_raw_data: &[],
+        cb_srl_data: &[],
+        cb_raw_data: &[],
+        cr_srl_data: &[],
+        cr_raw_data: &[],
+    })
+}
+
+fn stream(frame_index: u32, rect: RfxRectangle, tiles: Vec<ProgressiveTile<'_>>) -> Vec<u8> {
+    encode_progressive_stream(&[
+        ProgressiveBlock::Sync(ProgressiveSyncPdu),
+        ProgressiveBlock::Context(ProgressiveContextPdu {
+            context_id: 0,
+            tile_size: 64,
+            flags: 0,
+        }),
+        ProgressiveBlock::FrameBegin(ProgressiveFrameBeginPdu {
+            frame_index,
+            region_count: 1,
+        }),
+        ProgressiveBlock::Region(ProgressiveRegion {
+            tile_size: 64,
+            rects: vec![rect],
+            quant_vals: vec![ComponentCodecQuant::LOSSLESS],
+            quant_prog_vals: Vec::new(),
+            flags: 0,
+            tiles,
+        }),
+        ProgressiveBlock::FrameEnd(ProgressiveFrameEndPdu),
+    ])
+    .unwrap()
+}
+
+/// Design scenario P4: TILE_SIMPLE blocks across a 32768x32768 surface, each outside the REGION
+/// so nothing is drawn while every tile is kept. Returns the payloads the decoder accepted.
+fn tile_flood(decoder: &mut ProgressiveDecoder, component: &[u8], tiles: u32) -> usize {
+    const PER_CALL: u32 = 16;
+    let outside = RfxRectangle {
+        x: 0,
+        y: 0,
+        width: 64,
+        height: 64,
+    };
+    let mut accepted = 0;
+    for call in 0..tiles / PER_CALL {
+        let blocks = (0..PER_CALL)
+            .map(|i| {
+                // Skip tile (0, 0), the only one inside the REGION.
+                let n = call * PER_CALL + i + 1;
+                simple(component, u16::try_from(n % 512).unwrap(), u16::try_from(n / 512).unwrap())
+            })
+            .collect();
+        match decoder.decode_bitmap(1, 0, 32768, 32768, &stream(call, outside.clone(), blocks)) {
+            Ok(_) => accepted += 1,
+            Err(ProgressiveDecodeError::StateBudget { .. }) => {}
+            Err(error) => panic!("unexpected decode error: {error}"),
+        }
+    }
+    accepted
+}
+
+#[test]
+fn a_tile_flood_holds_no_more_than_the_state_budget() {
+    let _serial = SERIAL.lock().unwrap_or_else(std::sync::PoisonError::into_inner);
+    let component = zero_component();
+    let base = held();
+    let mut decoder = ProgressiveDecoder::with_state_budget(TEST_BUDGET);
+
+    // 4096 tiles keep about 250 MiB without a budget.
+    let accepted = tile_flood(&mut decoder, &component, 4096);
+    let flood_held = held() - base;
+    eprintln!(
+        "P4 tiles=4096 held={flood_held} state={} accepted={accepted}",
+        decoder.state_bytes()
+    );
+    assert!(
+        flood_held <= TEST_BUDGET + SLACK,
+        "decoder holds {flood_held} bytes against a {TEST_BUDGET} byte budget"
+    );
+    assert!(decoder.state_bytes() <= TEST_BUDGET);
+    // The budget charges what the decoder really holds, grid, tiles and references alike.
+    assert!(
+        flood_held <= decoder.state_bytes() + SLACK,
+        "decoder holds {flood_held} bytes but accounts for {}",
+        decoder.state_bytes()
+    );
+    assert!(accepted > 0, "payloads inside the budget must still decode");
+    assert!(accepted < 16, "payloads past the budget must be refused");
+
+    // Deleting the surface returns its bytes, so the same flood is accepted again.
+    decoder.delete_surface(1);
+    assert_eq!(decoder.state_bytes(), 0);
+    assert!(held() - base <= SLACK);
+    assert_eq!(tile_flood(&mut decoder, &component, 4096), accepted);
+
+    // A reset returns the tiles and grid; the sub-band references it keeps stay charged.
+    decoder.reset();
+    assert!(held() - base <= decoder.state_bytes() + SLACK);
+    drop(decoder);
+}
+
+#[test]
+fn surface_grids_are_charged_against_the_state_budget() {
+    let _serial = SERIAL.lock().unwrap_or_else(std::sync::PoisonError::into_inner);
+    // Design scenario P6: an empty frame on each of many 32768x32768 surfaces allocates a
+    // 2 MiB grid each, 128 MiB here without a budget.
+    let empty = encode_progressive_stream(&[
+        ProgressiveBlock::Sync(ProgressiveSyncPdu),
+        ProgressiveBlock::FrameBegin(ProgressiveFrameBeginPdu {
+            frame_index: 0,
+            region_count: 0,
+        }),
+        ProgressiveBlock::FrameEnd(ProgressiveFrameEndPdu),
+    ])
+    .unwrap();
+    let base = held();
+    let mut decoder = ProgressiveDecoder::with_state_budget(TEST_BUDGET);
+    let mut refused = 0;
+    for surface_id in 0..64 {
+        match decoder.decode_bitmap(surface_id, 0, 32768, 32768, &empty) {
+            Ok(_) => {}
+            Err(ProgressiveDecodeError::StateBudget { .. }) => refused += 1,
+            Err(error) => panic!("unexpected decode error: {error}"),
+        }
+    }
+    let grids_held = held() - base;
+    eprintln!("P6 surfaces=64 held={grids_held} state={} refused={refused}", decoder.state_bytes());
+    assert!(
+        grids_held <= TEST_BUDGET + SLACK,
+        "decoder holds {grids_held} bytes of grids against a {TEST_BUDGET} byte budget"
+    );
+    assert!(refused >= 60, "surfaces past the budget must be refused, refused {refused}");
+
+    // Resizing a surface returns its old grid before charging the new one.
+    decoder.delete_surface(0);
+    decoder.decode_bitmap(1, 0, 64, 64, &empty).unwrap();
+    decoder.decode_bitmap(1, 0, 32768, 32768, &empty).unwrap();
+    assert!(held() - base <= decoder.state_bytes() + SLACK);
+    drop(decoder);
+}
+
+#[test]
+fn two_4k_progressive_desktops_fit_the_default_budget() {
+    let _serial = SERIAL.lock().unwrap_or_else(std::sync::PoisonError::into_inner);
+    let component = zero_component();
+    let (width, height) = (3840u16, 2160u16);
+    let (tiles_wide, tiles_high) = (width.div_ceil(64), height.div_ceil(64));
+    let whole = RfxRectangle {
+        x: 0,
+        y: 0,
+        width,
+        height,
+    };
+    let base = held();
+    let mut decoder = ProgressiveDecoder::new();
+
+    // A first pass over every tile of both surfaces, then an upgrade pass over every tile.
+    for pass in 0..2u32 {
+        for surface_id in [1u16, 2] {
+            for y_idx in 0..tiles_high {
+                let tiles = (0..tiles_wide)
+                    .map(|x_idx| {
+                        if pass == 0 {
+                            simple(&component, x_idx, y_idx)
+                        } else {
+                            upgrade(x_idx, y_idx)
+                        }
+                    })
+                    .collect();
+                let drawn = decoder
+                    .decode_bitmap(surface_id, 0, width, height, &stream(pass, whole.clone(), tiles))
+                    .unwrap_or_else(|error| panic!("pass {pass} surface {surface_id} row {y_idx}: {error}"));
+                assert_eq!(drawn.len(), usize::from(tiles_wide), "every tile of the row is drawn");
+            }
+        }
+    }
+
+    let state = decoder.state_bytes();
+    eprintln!("two 4K desktops held={} state={state}", held() - base);
+    assert!(state <= DEFAULT_STATE_BUDGET / 2, "two 4K desktops hold {state} bytes");
+    assert!(held() - base <= state + SLACK);
+    drop(decoder);
+}
