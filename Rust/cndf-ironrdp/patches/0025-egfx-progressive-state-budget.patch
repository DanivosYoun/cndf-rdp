@@ -0,0 +1,131 @@
+//! Progressive state is kept only for surfaces the compositor holds a canvas for.
+//!
+//! A counting allocator measures what the client holds, so this runs in its own test binary.
+
+#![expect(unused_crate_dependencies, reason = "an integration test uses a few of the crate's dependencies")]
+#![expect(
+    clippy::unwrap_used,
+    clippy::print_stderr,
+    reason = "test helpers fail loudly and report the bytes they measured"
+)]
+
+use core::alloc::{GlobalAlloc, Layout};
+use core::sync::atomic::{AtomicUsize, Ordering::Relaxed};
+use std::alloc::System;
+
+use ironrdp_dvc::DvcProcessor as _;
+use ironrdp_egfx::client::{GraphicsPipelineClient, GraphicsPipelineHandler};
+use ironrdp_egfx::pdu::{
+    Codec2Type, CreateSurfacePdu, GfxPdu, PixelFormat, ResetGraphicsPdu, WireToSurface2Pdu,
+};
+use ironrdp_graphics::zgfx;
+use ironrdp_pdu::codecs::rfx::progressive::{
+    ProgressiveBlock, ProgressiveFrameBeginPdu, ProgressiveFrameEndPdu, ProgressiveSyncPdu, encode_progressive_stream,
+};
+
+struct Counting;
+
+static HELD: AtomicUsize = AtomicUsize::new(0);
+
+// SAFETY: forwards every call to `System` and only counts the sizes it allocated.
+unsafe impl GlobalAlloc for Counting {
+    unsafe fn alloc(&self, layout: Layout) -> *mut u8 {
+        // SAFETY: same contract as the caller's.
+        let ptr = unsafe { System.alloc(layout) };
+        if !ptr.is_null() {
+            HELD.fetch_add(layout.size(), Relaxed);
+        }
+        ptr
+    }
+
+    unsafe fn alloc_zeroed(&self, layout: Layout) -> *mut u8 {
+        // SAFETY: same contract as the caller's.
+        let ptr = unsafe { System.alloc_zeroed(layout) };
+        if !ptr.is_null() {
+            HELD.fetch_add(layout.size(), Relaxed);
+        }
+        ptr
+    }
+
+    unsafe fn dealloc(&self, ptr: *mut u8, layout: Layout) {
+        // SAFETY: same contract as the caller's.
+        unsafe { System.dealloc(ptr, layout) };
+        HELD.fetch_sub(layout.size(), Relaxed);
+    }
+
+    unsafe fn realloc(&self, ptr: *mut u8, layout: Layout, new_size: usize) -> *mut u8 {
+        // SAFETY: same contract as the caller's.
+        let new = unsafe { System.realloc(ptr, layout, new_size) };
+        if !new.is_null() {
+            HELD.fetch_sub(layout.size(), Relaxed);
+            HELD.fetch_add(new_size, Relaxed);
+        }
+        new
+    }
+}
+
+#[global_allocator]
+static ALLOCATOR: Counting = Counting;
+
+struct Handler;
+
+impl GraphicsPipelineHandler for Handler {}
+
+fn send(client: &mut GraphicsPipelineClient, pdu: &GfxPdu) {
+    let bytes = ironrdp_core::encode_vec(pdu).unwrap();
+    client.process(0, &zgfx::wrap_uncompressed(&bytes)).unwrap();
+}
+
+#[test]
+fn surfaces_without_a_canvas_keep_no_progressive_state() {
+    let mut client = GraphicsPipelineClient::new(Box::new(Handler), None);
+    send(
+        &mut client,
+        &GfxPdu::ResetGraphics(ResetGraphicsPdu {
+            width: 1024,
+            height: 768,
+            monitors: vec![],
+        }),
+    );
+    let empty_frame = encode_progressive_stream(&[
+        ProgressiveBlock::Sync(ProgressiveSyncPdu),
+        ProgressiveBlock::FrameBegin(ProgressiveFrameBeginPdu {
+            frame_index: 0,
+            region_count: 0,
+        }),
+        ProgressiveBlock::FrameEnd(ProgressiveFrameEndPdu),
+    ])
+    .unwrap();
+
+    let base = HELD.load(Relaxed);
+    // Design scenario P6 through the client: the compositor refuses every 32768x32768 canvas,
+    // and without the canvas check each surface's progressive grid takes 2 MiB, 128 MiB here.
+    for surface_id in 0..64 {
+        send(
+            &mut client,
+            &GfxPdu::CreateSurface(CreateSurfacePdu {
+                surface_id,
+                width: 32768,
+                height: 32768,
+                pixel_format: PixelFormat::XRgb,
+            }),
+        );
+        send(
+            &mut client,
+            &GfxPdu::WireToSurface2(WireToSurface2Pdu {
+                surface_id,
+                codec_id: Codec2Type::RemoteFxProgressive,
+                codec_context_id: 0,
+                pixel_format: PixelFormat::XRgb,
+                bitmap_data: empty_frame.clone(),
+            }),
+        );
+    }
+    let surfaces_held = HELD.load(Relaxed) - base;
+    eprintln!("P6 via client, surfaces=64 without a canvas: held={surfaces_held}");
+    assert!(
+        surfaces_held <= 1024 * 1024,
+        "client holds {surfaces_held} bytes for surfaces without a canvas"
+    );
+    assert_eq!(client.dropped_updates(), 0, "a surface without a canvas is not an undecodable update");
+}
