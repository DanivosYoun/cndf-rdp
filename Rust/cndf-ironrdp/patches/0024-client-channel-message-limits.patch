+// oracle: mutant without the RDPSND message limit, or ending the session for another reason.
+#[tokio::test]
+async fn an_oversized_server_audio_message_ends_the_session() {
+    const RDPSND: gcc::ChannelName = gcc::ChannelName::from_static(b"rdpsnd\0\0");
+    let oversized = vec![0x07; 3 * 1024 * 1024];
+
+    client_server_with_connector(
+        default_client_config(),
+        vec![Box::new(HostileChannelFactory(RDPSND, vec![oversized]))],
+        None,
+        |connector| connector.with_static_channel(Rdpsnd::new(Box::new(NoopRdpsndBackend))),
+        move |mut stage, _activation_factory, mut framed, display_tx, _echo_handle| async move {
+            let _display_tx = display_tx;
+            let failure = run_session_until(&mut stage, &mut framed, || false)
+                .await
+                .expect("the session went on");
+            assert!(
+                failure.contains("static channel message exceeds configured maximum size"),
+                "the session ended for another reason: {failure}"
+            );
+            (stage, framed)
+        },
+    )
+    .await;
+}
