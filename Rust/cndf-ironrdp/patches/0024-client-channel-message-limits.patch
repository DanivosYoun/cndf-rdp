+/// A server static channel that sends its messages once it starts and ignores the client's.
+#[derive(Debug)]
+struct HostileChannel {
+    name: gcc::ChannelName,
+    messages: Vec<Vec<u8>>,
+}
+
+impl_as_any!(HostileChannel);
+
+impl SvcProcessor for HostileChannel {
+    fn channel_name(&self) -> gcc::ChannelName {
+        self.name.clone()
+    }
+
+    fn start(&mut self) -> pdu::PduResult<Vec<SvcMessage>> {
+        Ok(core::mem::take(&mut self.messages)
+            .into_iter()
+            .map(SvcMessage::from)
+            .collect())
+    }
+
+    fn process(&mut self, _: &[u8]) -> pdu::PduResult<Vec<SvcMessage>> {
+        Ok(Vec::new())
+    }
+}
+
+impl SvcServerProcessor for HostileChannel {}
+
+struct HostileChannelFactory(gcc::ChannelName, Vec<Vec<u8>>);
+
+impl StaticChannelFactory for HostileChannelFactory {
+    fn attach(&self, acceptor: &mut Acceptor) {
+        acceptor.attach_static_channel(HostileChannel {
+            name: self.0.clone(),
+            messages: self.1.clone(),
+        });
+    }
+}
+
+/// A CLIPRDR message with a `body_len` body of `b'A'`.
+fn cliprdr_message(msg_type: u16, body_len: usize) -> Vec<u8> {
+    let mut bytes = msg_type.to_le_bytes().to_vec();
+    bytes.extend_from_slice(&1u16.to_le_bytes());
+    bytes.extend_from_slice(&u32::try_from(body_len).unwrap().to_le_bytes());
+    bytes.resize(8 + body_len, b'A');
+    bytes
+}
+
+/// What the client clipboard handed to the app.
+#[derive(Debug, Default)]
+struct ClipboardSeen {
+    data: Vec<usize>,
+    failures: usize,
+}
+
+#[derive(Debug)]
+struct RecordingClipboard(Arc<StdMutex<ClipboardSeen>>);
+
+impl_as_any!(RecordingClipboard);
+
+impl ironrdp::cliprdr::backend::CliprdrBackend for RecordingClipboard {
+    fn temporary_directory(&self) -> &str {
+        ".cliprdr"
+    }
+
+    fn client_capabilities(&self) -> ironrdp::cliprdr::pdu::ClipboardGeneralCapabilityFlags {
+        ironrdp::cliprdr::pdu::ClipboardGeneralCapabilityFlags::empty()
+    }
+
+    fn on_ready(&mut self) {}
+
+    fn on_request_format_list(&mut self) {}
+
+    fn on_process_negotiated_capabilities(&mut self, _: ironrdp::cliprdr::pdu::ClipboardGeneralCapabilityFlags) {}
+
+    fn on_remote_copy(&mut self, _: &[ironrdp::cliprdr::pdu::ClipboardFormat]) {}
+
+    fn on_format_data_request(&mut self, _: ironrdp::cliprdr::pdu::FormatDataRequest) {}
+
+    fn on_format_data_response(&mut self, response: ironrdp::cliprdr::pdu::FormatDataResponse<'_>) {
+        let mut seen = self.0.lock().unwrap();
+        if response.is_error() {
+            seen.failures += 1;
+        } else {
+            seen.data.push(response.data().len());
+        }
+    }
+
+    fn on_file_contents_request(&mut self, _: ironrdp::cliprdr::pdu::FileContentsRequest) {}
+
+    fn on_file_contents_response(&mut self, _: ironrdp::cliprdr::pdu::FileContentsResponse<'_>) {}
+
+    fn on_lock(&mut self, _: ironrdp::cliprdr::pdu::LockDataId) {}
+
+    fn on_unlock(&mut self, _: ironrdp::cliprdr::pdu::LockDataId) {}
+}
