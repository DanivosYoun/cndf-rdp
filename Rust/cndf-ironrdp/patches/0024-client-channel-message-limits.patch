+// oracle: mutant accepting an oversized message whose item cannot fail alone.
+#[test]
+fn another_oversized_message_fails_the_channel() {
+    let mut channel = text_channel(0);
+    // A Lock Clipboard Data PDU is 4 bytes; one this long is otherwise decoded from its start.
+    let oversized = message(LOCK_CLIPDATA, 0, &[], MAX_MESSAGE_SIZE);
+    assert!(send(&mut channel, &oversized).is_err());
+}
