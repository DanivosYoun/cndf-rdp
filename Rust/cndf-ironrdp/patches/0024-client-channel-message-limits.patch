diff --git a/crates/ironrdp-testsuite-core/tests/clipboard/oversized_messages.rs b/crates/ironrdp-testsuite-core/tests/clipboard/oversized_messages.rs
new file mode 100644
index 0000000..62a0c78
--- /dev/null
+++ b/crates/ironrdp-testsuite-core/tests/clipboard/oversized_messages.rs
@@ -0,0 +1,252 @@
+//! CLIPRDR messages over [`ironrdp_cliprdr::MAX_MESSAGE_SIZE`] fail only the item they carry.
+
+use std::sync::{Arc, Mutex};
+
+use ironrdp_cliprdr::pdu::{
+    ClipboardFormat, ClipboardFormatId, ClipboardPdu, FileContentsFlags, FileContentsRequest, FileDescriptor,
+    FormatDataResponse, FormatListResponse,
+};
+use ironrdp_cliprdr::{CliprdrClient, MAX_MESSAGE_SIZE};
+use ironrdp_pdu::PduResult;
+use ironrdp_svc::{StaticVirtualChannel, SvcMessage};
+use ironrdp_testsuite_core::clipboard::{
+    FormatDataRecordingBackend, ReceivedResponse, RecordingBackend, init_ready_client_with_backend,
+    set_remote_file_list,
+};
+
+const FORMAT_LIST: u16 = 0x0002;
+const FORMAT_DATA_RESPONSE: u16 = 0x0005;
+const LOCK_CLIPDATA: u16 = 0x000A;
+const FILE_CONTENTS_RESPONSE: u16 = 0x0009;
+const CB_RESPONSE_OK: u16 = 0x0001;
+
+/// A CLIPRDR message with a `body_len` body of `fill` bytes after `body_start`.
+fn message(msg_type: u16, msg_flags: u16, body_start: &[u8], body_len: usize) -> Vec<u8> {
+    let mut bytes = Vec::with_capacity(8 + body_len);
+    bytes.extend_from_slice(&msg_type.to_le_bytes());
+    bytes.extend_from_slice(&msg_flags.to_le_bytes());
+    bytes.extend_from_slice(&u32::try_from(body_len).unwrap().to_le_bytes());
+    bytes.extend_from_slice(body_start);
+    bytes.resize(8 + body_len, b'A');
+    bytes
+}
+
+/// Sends `message` over the channel in fragments, as the server does, returning the replies.
+fn send(channel: &mut StaticVirtualChannel, message: &[u8]) -> PduResult<Vec<SvcMessage>> {
+    const CHUNK: usize = 1600;
+    let declared = u32::try_from(message.len()).unwrap();
+    let mut replies = Vec::new();
+    let count = message.len().div_ceil(CHUNK);
+    for (i, chunk) in message.chunks(CHUNK).enumerate() {
+        let mut flags = 0u32;
+        if i == 0 {
+            flags |= 1;
+        }
+        if i + 1 == count {
+            flags |= 2;
+        }
+        let mut fragment = declared.to_le_bytes().to_vec();
+        fragment.extend_from_slice(&flags.to_le_bytes());
+        fragment.extend_from_slice(chunk);
+        replies.extend(channel.process(&fragment)?);
+    }
+    Ok(replies)
+}
+
+fn cliprdr(channel: &mut StaticVirtualChannel) -> &mut CliprdrClient {
+    channel.channel_processor_downcast_mut().unwrap()
+}
+
+fn format_data(channel: &mut StaticVirtualChannel) -> &FormatDataRecordingBackend {
+    cliprdr(channel).downcast_backend().unwrap()
+}
+
+fn text_channel(pastes: usize) -> StaticVirtualChannel {
+    let mut client = init_ready_client_with_backend(Box::new(FormatDataRecordingBackend::default()));
+    for _ in 0..pastes {
+        let _: Vec<_> = client.initiate_paste(ClipboardFormatId::CF_UNICODETEXT).unwrap().into();
+    }
+    StaticVirtualChannel::new(client)
+}
+
+fn text_response(text: &[u8]) -> Vec<u8> {
+    ironrdp_core::encode_vec(&ClipboardPdu::FormatDataResponse(FormatDataResponse::new_data(text))).unwrap()
+}
+
+fn decoded(replies: &[SvcMessage]) -> Vec<String> {
+    replies
+        .iter()
+        .map(|reply| {
+            let bytes = reply.encode_unframed_pdu().unwrap();
+            format!("{:?}", ironrdp_core::decode::<ClipboardPdu<'_>>(&bytes).unwrap())
+        })
+        .collect()
+}
+
+// oracle: mutant not taking the pending request of an oversized response, shifting later responses onto the
+// wrong request, or delivering the oversized data.
+#[test]
+fn an_oversized_format_data_response_fails_only_its_own_request() {
+    let mut channel = text_channel(3);
+    let oversized = message(FORMAT_DATA_RESPONSE, CB_RESPONSE_OK, &[], MAX_MESSAGE_SIZE - 8 + 1);
+    assert!(send(&mut channel, &oversized).unwrap().is_empty());
+    assert!(send(&mut channel, &text_response(b"a\0")).unwrap().is_empty());
+    assert!(send(&mut channel, &text_response(b"b\0")).unwrap().is_empty());
+
+    let seen = format_data(&mut channel);
+    assert_eq!(seen.error_responses, 1);
+    assert_eq!(seen.data_responses, [b"a\0".to_vec(), b"b\0".to_vec()]);
+}
+
+// oracle: mutant classifying a clipboard message at the limit as oversized.
+#[test]
+fn a_format_data_response_at_the_limit_is_delivered() {
+    let mut channel = text_channel(1);
+    let at_limit = message(FORMAT_DATA_RESPONSE, CB_RESPONSE_OK, &[], MAX_MESSAGE_SIZE - 8);
+    assert!(send(&mut channel, &at_limit).unwrap().is_empty());
+
+    let seen = format_data(&mut channel);
+    assert_eq!(seen.error_responses, 0);
+    assert_eq!(seen.data_responses.len(), 1);
+    assert_eq!(seen.data_responses[0].len(), MAX_MESSAGE_SIZE - 8);
+}
+
+// oracle: mutant answering the request after the file list's with an oversized response for the file list.
+#[test]
+fn an_oversized_file_list_response_fails_the_file_list_request() {
+    let file_list = ClipboardFormatId::new(49534);
+    let mut client = init_ready_client_with_backend(Box::new(FormatDataRecordingBackend::default()));
+    set_remote_file_list(&mut client, vec![FileDescriptor::new("a.txt").with_file_size(1)]);
+    let _: Vec<_> = client.initiate_paste(file_list).unwrap().into();
+    let _: Vec<_> = client.initiate_paste(ClipboardFormatId::CF_UNICODETEXT).unwrap().into();
+    let mut channel = StaticVirtualChannel::new(client);
+
+    let oversized = message(FORMAT_DATA_RESPONSE, CB_RESPONSE_OK, &[], MAX_MESSAGE_SIZE);
+    assert!(send(&mut channel, &oversized).unwrap().is_empty());
+    assert!(send(&mut channel, &text_response(b"t\0")).unwrap().is_empty());
+
+    let seen = format_data(&mut channel);
+    assert_eq!(seen.error_responses, 1);
+    assert_eq!(
+        seen.file_lists.len(),
+        1,
+        "only the file list sent before the oversized response"
+    );
+    assert_eq!(seen.data_responses, [b"t\0".to_vec()]);
+}
+
+// oracle: mutant leaving the oversized response's request pending, so the next response pairs with it.
+#[test]
+fn the_response_after_an_oversized_one_pairs_with_the_next_request() {
+    let file_list = ClipboardFormatId::new(49534);
+    let mut client = init_ready_client_with_backend(Box::new(FormatDataRecordingBackend::default()));
+    set_remote_file_list(&mut client, vec![FileDescriptor::new("a.txt").with_file_size(1)]);
+    let _: Vec<_> = client.initiate_paste(ClipboardFormatId::CF_UNICODETEXT).unwrap().into();
+    let _: Vec<_> = client.initiate_paste(file_list).unwrap().into();
+    let mut channel = StaticVirtualChannel::new(client);
+
+    // The text request is answered over the limit, then the file list request with a file list.
+    let oversized = message(FORMAT_DATA_RESPONSE, CB_RESPONSE_OK, &[], MAX_MESSAGE_SIZE);
+    assert!(send(&mut channel, &oversized).unwrap().is_empty());
+    let list = ironrdp_cliprdr::pdu::PackedFileList {
+        files: vec![FileDescriptor::new("b.txt").with_file_size(2)],
+    };
+    let response = ClipboardPdu::FormatDataResponse(FormatDataResponse::new_file_list(&list).unwrap());
+    assert!(
+        send(&mut channel, &ironrdp_core::encode_vec(&response).unwrap())
+            .unwrap()
+            .is_empty()
+    );
+
+    let seen = format_data(&mut channel);
+    assert_eq!(seen.error_responses, 1);
+    assert!(seen.data_responses.is_empty(), "the file list was taken for the text");
+    assert_eq!(seen.file_lists.len(), 2);
+    assert_eq!(seen.file_lists[1][0].name, "b.txt");
+}
+
+// oracle: mutant failing the channel, or failing a stream other than the oversized response's.
+#[test]
+fn an_oversized_file_contents_response_fails_only_its_stream() {
+    let responses = Arc::new(Mutex::new(Vec::new()));
+    let mut client = init_ready_client_with_backend(Box::new(RecordingBackend {
+        responses: Arc::clone(&responses),
+    }));
+    set_remote_file_list(&mut client, vec![FileDescriptor::new("a.bin").with_file_size(1 << 30)]);
+    for stream_id in [1, 2] {
+        client
+            .request_file_contents(FileContentsRequest {
+                stream_id,
+                index: 0,
+                flags: FileContentsFlags::RANGE,
+                position: 0,
+                requested_size: 1024,
+                data_id: None,
+            })
+            .unwrap();
+    }
+    let mut channel = StaticVirtualChannel::new(client);
+
+    let oversized = message(
+        FILE_CONTENTS_RESPONSE,
+        CB_RESPONSE_OK,
+        &1u32.to_le_bytes(),
+        MAX_MESSAGE_SIZE,
+    );
+    assert!(send(&mut channel, &oversized).unwrap().is_empty());
+    let ok = message(FILE_CONTENTS_RESPONSE, CB_RESPONSE_OK, &2u32.to_le_bytes(), 4 + 16);
+    assert!(send(&mut channel, &ok).unwrap().is_empty());
+
+    let responses = responses.lock().unwrap();
+    let seen: Vec<_> = responses
+        .iter()
+        .map(
+            |ReceivedResponse {
+                 stream_id,
+                 is_error,
+                 data_len,
+             }| (*stream_id, *is_error, *data_len),
+        )
+        .collect();
+    assert_eq!(seen, [(1, true, 0), (2, false, 16)]);
+    assert!(cliprdr(&mut channel).__test_sent_file_contents_requests().is_empty());
+}
+
+// oracle: mutant answering an oversized format list with FormatListResponse::Ok, or not answering it.
+#[test]
+fn an_oversized_format_list_is_rejected() {
+    let mut channel = text_channel(0);
+    let oversized = message(FORMAT_LIST, 0, &[], MAX_MESSAGE_SIZE);
+    let replies = send(&mut channel, &oversized).unwrap();
+    assert_eq!(
+        decoded(&replies),
+        [format!(
+            "{:?}",
+            ClipboardPdu::FormatListResponse(FormatListResponse::Fail)
+        )]
+    );
+
+    // A format list within the limit is still accepted.
+    let formats = [ClipboardFormat::new(ClipboardFormatId::CF_UNICODETEXT)];
+    let format_list = ironrdp_core::encode_vec(&ClipboardPdu::FormatList(
+        ironrdp_cliprdr::pdu::FormatList::new_unicode(&formats, true).unwrap(),
+    ))
+    .unwrap();
+    let replies = send(&mut channel, &format_list).unwrap();
+    assert_eq!(
+        decoded(&replies),
+        [format!(
+            "{:?}",
+            ClipboardPdu::FormatListResponse(FormatListResponse::Ok)
+        )]
+    );
+}
