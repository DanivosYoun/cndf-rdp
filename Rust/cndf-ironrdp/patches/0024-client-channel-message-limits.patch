+// oracle: mutant without the CLIPRDR message limit, or failing the session instead of the oversized item.
+#[tokio::test]
+async fn an_oversized_server_clipboard_response_fails_only_its_item() {
+    const CLIPRDR: gcc::ChannelName = gcc::ChannelName::from_static(b"cliprdr\0");
+    // One byte over the client's 64 MiB CLIPRDR limit, then a response within it.
+    let oversized = cliprdr_message(0x0005, ironrdp::cliprdr::MAX_MESSAGE_SIZE - 8 + 1);
+    let next = cliprdr_message(0x0005, 16);
+    let seen = Arc::new(StdMutex::new(ClipboardSeen::default()));
+    let client_seen = Arc::clone(&seen);
+
+    client_server_with_connector(
+        default_client_config(),
+        vec![Box::new(HostileChannelFactory(CLIPRDR, vec![oversized, next]))],
+        None,
+        move |connector| {
+            connector.with_static_channel(ironrdp::cliprdr::CliprdrClient::new(Box::new(RecordingClipboard(
+                client_seen,
+            ))))
+        },
+        move |mut stage, _activation_factory, mut framed, display_tx, _echo_handle| async move {
+            let _display_tx = display_tx;
+            let failure = run_session_until(&mut stage, &mut framed, || {
+                let seen = seen.lock().unwrap();
+                seen.failures + seen.data.len() >= 2
+            })
+            .await;
+            assert_eq!(failure, None, "the session failed");
+            let seen = seen.lock().unwrap();
+            assert_eq!(seen.failures, 1, "the oversized response is not failed");
+            assert_eq!(seen.data, [16], "the next response is not delivered");
+            drop(seen);
+            (stage, framed)
+        },
+    )
+    .await;
+}
