@@ -0,0 +1,182 @@
+//! Bytes a client holds while the server sends a CLIPRDR message over [`MAX_MESSAGE_SIZE`].
+
+use std::alloc::{GlobalAlloc, Layout, System};
+use std::cell::Cell;
+
+use bitflags as _;
+use ironrdp_cliprdr::backend::CliprdrBackend;
+use ironrdp_cliprdr::pdu::{
+    ClipboardFormat, ClipboardFormatId, ClipboardGeneralCapabilityFlags, FileContentsRequest, FileContentsResponse,
+    FormatDataRequest, FormatDataResponse, LockDataId,
+};
+use ironrdp_cliprdr::{CliprdrClient, MAX_MESSAGE_SIZE};
+use ironrdp_svc::StaticVirtualChannel;
+use tracing as _;
+#[cfg(feature = "__test")]
+use visibility as _;
+use {ironrdp_core as _, ironrdp_pdu as _};
+
+/// Counts the bytes each thread holds, so tests running in parallel do not disturb each other.
+struct CountingAllocator;
+
+thread_local! {
+    static HELD: Cell<isize> = const { Cell::new(0) };
+}
+
+fn track(delta: isize) {
+    let _ = HELD.try_with(|held| held.set(held.get() + delta));
+}
+
+// SAFETY: Forwards to the system allocator and only counts.
+unsafe impl GlobalAlloc for CountingAllocator {
+    unsafe fn alloc(&self, layout: Layout) -> *mut u8 {
+        // SAFETY: Same contract as the caller's.
+        let ptr = unsafe { System.alloc(layout) };
+        if !ptr.is_null() {
+            track(layout.size().cast_signed());
+        }
+        ptr
+    }
+
+    unsafe fn alloc_zeroed(&self, layout: Layout) -> *mut u8 {
+        // SAFETY: Same contract as the caller's.
+        let ptr = unsafe { System.alloc_zeroed(layout) };
+        if !ptr.is_null() {
+            track(layout.size().cast_signed());
+        }
+        ptr
+    }
+
+    unsafe fn dealloc(&self, ptr: *mut u8, layout: Layout) {
+        // SAFETY: Same contract as the caller's.
+        unsafe { System.dealloc(ptr, layout) };
+        track(-layout.size().cast_signed());
+    }
+
+    unsafe fn realloc(&self, ptr: *mut u8, layout: Layout, new_size: usize) -> *mut u8 {
+        // SAFETY: Same contract as the caller's.
+        let new_ptr = unsafe { System.realloc(ptr, layout, new_size) };
+        if !new_ptr.is_null() {
+            track(new_size.cast_signed() - layout.size().cast_signed());
+        }
+        new_ptr
+    }
+}
+
+#[global_allocator]
+static ALLOCATOR: CountingAllocator = CountingAllocator;
+
+fn held() -> isize {
+    HELD.with(Cell::get)
+}
+
+/// Records what reaches the app: response data lengths and failures.
+#[derive(Debug, Default)]
+struct Backend {
+    data: Vec<usize>,
+    failures: usize,
+}
+
+ironrdp_core::impl_as_any!(Backend);
+
+impl CliprdrBackend for Backend {
+    fn temporary_directory(&self) -> &str {
+        "/tmp"
+    }
+    fn client_capabilities(&self) -> ClipboardGeneralCapabilityFlags {
+        ClipboardGeneralCapabilityFlags::USE_LONG_FORMAT_NAMES
+    }
+    fn on_ready(&mut self) {}
+    fn on_request_format_list(&mut self) {}
+    fn on_process_negotiated_capabilities(&mut self, _: ClipboardGeneralCapabilityFlags) {}
+    fn on_remote_copy(&mut self, _: &[ClipboardFormat]) {}
+    fn on_format_data_request(&mut self, _: FormatDataRequest) {}
+    fn on_format_data_response(&mut self, response: FormatDataResponse<'_>) {
+        if response.is_error() {
+            self.failures += 1;
+        } else {
+            self.data.push(response.data().len());
+        }
+    }
+    fn on_file_contents_request(&mut self, _: FileContentsRequest) {}
+    fn on_file_contents_response(&mut self, _: FileContentsResponse<'_>) {}
+    fn on_lock(&mut self, _: LockDataId) {}
+    fn on_unlock(&mut self, _: LockDataId) {}
+}
+
+/// One unfragmented channel message.
+fn single(message: &[u8]) -> Vec<u8> {
+    let mut fragment = u32::try_from(message.len()).unwrap().to_le_bytes().to_vec();
+    fragment.extend_from_slice(&3u32.to_le_bytes());
+    fragment.extend_from_slice(message);
+    fragment
+}
+
+// oracle: mutant reassembling a clipboard message over the limit, or one without a CLIPRDR message limit.
+#[test]
+fn an_oversized_server_response_is_not_held() {
+    let mut channel = StaticVirtualChannel::new(CliprdrClient::new(Box::new(Backend::default())));
+    // Server Capabilities (general, long format names) and Monitor Ready complete the initialization.
+    let capabilities = [
+        0x07, 0x00, 0x00, 0x00, 0x10, 0x00, 0x00, 0x00, 0x01, 0x00, 0x00, 0x00, 0x01, 0x00, 0x0c, 0x00, 0x02, 0x00,
+        0x00, 0x00, 0x02, 0x00, 0x00, 0x00,
+    ];
+    channel.process(&single(&capabilities)).unwrap();
+    channel
+        .process(&single(&[0x01, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00]))
+        .unwrap();
+    let cliprdr = channel.channel_processor_downcast_mut::<CliprdrClient>().unwrap();
+    let _: Vec<_> = cliprdr.initiate_copy(&[]).unwrap().into();
+    // Format List Response (CB_RESPONSE_OK) to the client's copy.
+    channel
+        .process(&single(&[0x03, 0x00, 0x01, 0x00, 0x00, 0x00, 0x00, 0x00]))
+        .unwrap();
+    let cliprdr = channel.channel_processor_downcast_mut::<CliprdrClient>().unwrap();
+    let _: Vec<_> = cliprdr
+        .initiate_paste(ClipboardFormatId::CF_UNICODETEXT)
+        .unwrap()
+        .into();
+    let _: Vec<_> = cliprdr
+        .initiate_paste(ClipboardFormatId::CF_UNICODETEXT)
+        .unwrap()
+        .into();
+
+    // The response is one byte over the limit, sent in 1600-byte fragments from one reused buffer.
+    let total = MAX_MESSAGE_SIZE + 1;
+    let declared = u32::try_from(total).unwrap();
+    let mut fragment = Vec::with_capacity(8 + 1600);
+    let start = held();
+    let mut peak = 0;
+    let mut sent = 0;
+    while sent < total {
+        let length = 1600.min(total - sent);
+        let flags = u32::from(sent == 0) | (u32::from(sent + length == total) << 1);
+        fragment.clear();
+        fragment.extend_from_slice(&declared.to_le_bytes());
+        fragment.extend_from_slice(&flags.to_le_bytes());
+        if sent == 0 {
+            // FormatDataResponse, CB_RESPONSE_OK, dataLen.
+            fragment.extend_from_slice(&[0x05, 0x00, 0x01, 0x00]);
+            fragment.extend_from_slice(&(declared - 8).to_le_bytes());
+            fragment.resize(8 + length, b'A');
+        } else {
+            fragment.resize(8 + length, b'A');
+        }
+        let replies = channel.process(&fragment).unwrap();
+        assert!(replies.is_empty());
+        peak = peak.max(held() - start);
+        sent += length;
+    }
+    assert!(peak <= 4096, "held {peak} bytes for an oversized clipboard response");
+
+    // The next response is paired with the next paste and delivered.
+    let response = [0x05, 0x00, 0x01, 0x00, 0x04, 0x00, 0x00, 0x00, b'o', 0, b'k', 0];
+    channel.process(&single(&response)).unwrap();
+    let backend = channel
+        .channel_processor_downcast_ref::<CliprdrClient>()
+        .unwrap()
+        .downcast_backend::<Backend>()
+        .unwrap();
+    assert_eq!(backend.failures, 1);
+    assert_eq!(backend.data, [4]);
+}
