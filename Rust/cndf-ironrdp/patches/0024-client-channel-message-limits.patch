diff --git a/crates/ironrdp-svc/tests/oversized_messages.rs b/crates/ironrdp-svc/tests/oversized_messages.rs
new file mode 100644
index 0000000..085e7b2
--- /dev/null
+++ b/crates/ironrdp-svc/tests/oversized_messages.rs
@@ -0,0 +1,292 @@
+//! Static channel messages over the size limit under the discard and fail policies.
+
+use std::alloc::{GlobalAlloc, Layout, System};
+use std::cell::Cell;
+
+use bitflags as _;
+use ironrdp_pdu::PduResult;
+use ironrdp_pdu::gcc::ChannelName;
+use ironrdp_svc::{
+    OVERSIZED_MESSAGE_PREFIX_LENGTH, OversizedMessagePolicy, StaticVirtualChannel, SvcMessage, SvcProcessor,
+};
+
+/// Counts the bytes each thread holds, so tests running in parallel do not disturb each other.
+struct CountingAllocator;
+
+thread_local! {
+    static HELD: Cell<isize> = const { Cell::new(0) };
+}
+
+fn track(delta: isize) {
+    let _ = HELD.try_with(|held| held.set(held.get() + delta));
+}
+
+// SAFETY: Forwards to the system allocator and only counts.
+unsafe impl GlobalAlloc for CountingAllocator {
+    unsafe fn alloc(&self, layout: Layout) -> *mut u8 {
+        // SAFETY: Same contract as the caller's.
+        let ptr = unsafe { System.alloc(layout) };
+        if !ptr.is_null() {
+            track(layout.size().cast_signed());
+        }
+        ptr
+    }
+
+    unsafe fn alloc_zeroed(&self, layout: Layout) -> *mut u8 {
+        // SAFETY: Same contract as the caller's.
+        let ptr = unsafe { System.alloc_zeroed(layout) };
+        if !ptr.is_null() {
+            track(layout.size().cast_signed());
+        }
+        ptr
+    }
+
+    unsafe fn dealloc(&self, ptr: *mut u8, layout: Layout) {
+        // SAFETY: Same contract as the caller's.
+        unsafe { System.dealloc(ptr, layout) };
+        track(-layout.size().cast_signed());
+    }
+
+    unsafe fn realloc(&self, ptr: *mut u8, layout: Layout, new_size: usize) -> *mut u8 {
+        // SAFETY: Same contract as the caller's.
+        let new_ptr = unsafe { System.realloc(ptr, layout, new_size) };
+        if !new_ptr.is_null() {
+            track(new_size.cast_signed() - layout.size().cast_signed());
+        }
+        new_ptr
+    }
+}
+
+#[global_allocator]
+static ALLOCATOR: CountingAllocator = CountingAllocator;
+
+fn held() -> isize {
+    HELD.with(Cell::get)
+}
+
+const FIRST: u32 = 1;
+const LAST: u32 = 2;
+const CHUNK: usize = 16 * 1024;
+const MIB: usize = 1024 * 1024;
+
+#[derive(Debug)]
+struct Recorder {
+    limit: Option<usize>,
+    policy: OversizedMessagePolicy,
+    context: Option<u64>,
+    messages: Vec<Vec<u8>>,
+    oversized: Vec<(Vec<u8>, usize)>,
+}
+
+ironrdp_core::impl_as_any!(Recorder);
+
+impl SvcProcessor for Recorder {
+    fn channel_name(&self) -> ChannelName {
+        ChannelName::from_static(b"testovr\0")
+    }
+
+    fn max_message_size(&self) -> Option<usize> {
+        self.limit
+    }
+
+    fn oversized_message_policy(&self) -> OversizedMessagePolicy {
+        self.policy
+    }
+
+    fn message_context(&self) -> Option<u64> {
+        self.context
+    }
+
+    fn process(&mut self, payload: &[u8]) -> PduResult<Vec<SvcMessage>> {
+        self.messages.push(payload.to_vec());
+        Ok(Vec::new())
+    }
+
+    fn process_oversized(&mut self, prefix: &[u8], declared_length: usize) -> PduResult<Vec<SvcMessage>> {
+        self.oversized.push((prefix.to_vec(), declared_length));
+        Ok(vec![SvcMessage::from(vec![0xee])])
+    }
+}
+
+fn new_channel(limit: usize, policy: OversizedMessagePolicy) -> StaticVirtualChannel {
+    StaticVirtualChannel::new(Recorder {
+        limit: Some(limit),
+        policy,
+        context: Some(0),
+        messages: Vec::new(),
+        oversized: Vec::new(),
+    })
+}
+
+fn recorder_of(channel: &StaticVirtualChannel) -> &Recorder {
+    channel.channel_processor_downcast_ref().expect("recorder")
+}
+
+fn frame(length: u32, flags: u32, data: &[u8]) -> Vec<u8> {
+    let mut bytes = length.to_le_bytes().to_vec();
+    bytes.extend_from_slice(&flags.to_le_bytes());
+    bytes.extend_from_slice(data);
+    bytes
+}
+
+fn pattern(offset: usize, length: usize) -> Vec<u8> {
+    (offset..offset + length).map(|i| (i % 251) as u8).collect()
+}
+
+/// What the channel answered to a stream of fragments.
+#[derive(Debug, Default)]
+struct Streamed {
+    /// Fragments answered with no reply.
+    silent: usize,
+    /// The replies to the last fragment.
+    last_replies: usize,
+    failed: bool,
+    /// The most bytes held after any fragment, beyond those held before the first.
+    peak: isize,
+}
+
+/// Sends `total` bytes declared as `declared`, in `CHUNK` fragments, stopping at the first failure and before
+/// the terminal fragment unless `finish`.
+fn stream(channel: &mut StaticVirtualChannel, declared: u32, total: usize, finish: bool) -> Streamed {
+    let mut streamed = Streamed::default();
+    // One reused buffer, so the fragments themselves are not counted as held.
+    let mut buffer = Vec::with_capacity(8 + CHUNK);
+    let start = held();
+    let mut offset = 0;
+    while offset < total {
+        let length = CHUNK.min(total - offset);
+        let mut flags = 0;
+        if offset == 0 {
+            flags |= FIRST;
+        }
+        if finish && offset + length == total {
+            flags |= LAST;
+        }
+        buffer.clear();
+        buffer.extend_from_slice(&declared.to_le_bytes());
+        buffer.extend_from_slice(&flags.to_le_bytes());
+        buffer.extend((offset..offset + length).map(|i| (i % 251) as u8));
+        let result = channel.process(&buffer);
+        streamed.peak = streamed.peak.max(held() - start);
+        offset += length;
+        match result {
+            Ok(replies) if offset == total => streamed.last_replies = replies.len(),
+            Ok(replies) => {
+                assert!(replies.is_empty());
+                streamed.silent += 1;
+            }
+            Err(_) => {
+                streamed.failed = true;
+                break;
+            }
+        }
+    }
+    streamed
+}
+
+// oracle: mutant keeping the payload of a discarded message, not handing over its first bytes, or not calling
+// process_oversized once at the terminal fragment.
+#[test]
+fn discarded_message_keeps_only_its_first_bytes_and_is_reported_once() {
+    let mut channel = new_channel(MIB, OversizedMessagePolicy::Discard);
+    let total = 8 * MIB;
+    let streamed = stream(&mut channel, u32::try_from(total).unwrap(), total, true);
+
+    assert!(streamed.peak <= 1024, "held {} bytes while discarding", streamed.peak);
+    assert!(!streamed.failed);
+    assert_eq!(streamed.silent, total / CHUNK - 1);
+    assert_eq!(streamed.last_replies, 1, "the reply of process_oversized");
+    let recorder = recorder_of(&channel);
+    assert!(recorder.messages.is_empty());
+    assert_eq!(
+        recorder.oversized,
+        [(pattern(0, OVERSIZED_MESSAGE_PREFIX_LENGTH), total)]
+    );
+
+    // A following message within the limit is delivered whole.
+    let message = pattern(7, 100);
+    let replies = channel.process(&frame(100, FIRST | LAST, &message)).unwrap();
+    assert!(replies.is_empty());
+    assert_eq!(recorder_of(&channel).messages, [message]);
+    assert_eq!(recorder_of(&channel).oversized.len(), 1);
+}
+
+// oracle: mutant retaining the fragments of a sequence declared far over the limit.
+#[test]
+fn discarding_a_4gib_declaration_holds_no_payload() {
+    let mut channel = new_channel(16 * MIB, OversizedMessagePolicy::Discard);
+    let streamed = stream(&mut channel, u32::MAX, 64 * MIB, false);
+    assert!(!streamed.failed);
+    assert_eq!(streamed.last_replies, 0);
+    assert!(streamed.peak <= 1024, "held {} bytes while discarding", streamed.peak);
+}
+
+// oracle: mutant off by one at the limit.
+#[test]
+fn a_message_at_the_limit_is_delivered_and_one_byte_over_is_discarded() {
+    let limit = 4 * CHUNK;
+    let mut channel = new_channel(limit, OversizedMessagePolicy::Discard);
+    let streamed = stream(&mut channel, u32::try_from(limit).unwrap(), limit, true);
+    assert!(!streamed.failed);
+    assert_eq!(streamed.last_replies, 0);
+    assert_eq!(recorder_of(&channel).messages, [pattern(0, limit)]);
+
+    let streamed = stream(&mut channel, u32::try_from(limit + 1).unwrap(), limit + 1, true);
+    assert!(!streamed.failed);
+    assert_eq!(streamed.last_replies, 1);
+    assert_eq!(recorder_of(&channel).messages.len(), 1);
+    assert_eq!(recorder_of(&channel).oversized, [(pattern(0, 64), limit + 1)]);
+}
+
+// oracle: mutant failing or keeping fragments under the default policy.
+#[test]
+fn the_fail_policy_rejects_the_first_fragment_and_keeps_nothing() {
+    let mut channel = new_channel(16 * MIB, OversizedMessagePolicy::Fail);
+    let streamed = stream(&mut channel, u32::MAX, 64 * MIB, false);
+    assert!(streamed.failed);
+    assert_eq!(streamed.silent, 0, "fails at the first fragment");
+    assert!(streamed.peak <= 1024, "held {} bytes after failing", streamed.peak);
+    assert!(recorder_of(&channel).oversized.is_empty());
+}
+
+// oracle: mutant reporting a discarded message to a recipient that replaced the original one.
+#[test]
+fn a_changed_recipient_gets_no_oversized_report() {
+    let mut channel = new_channel(CHUNK, OversizedMessagePolicy::Discard);
+    channel
+        .process(&frame(u32::try_from(3 * CHUNK).unwrap(), FIRST, &pattern(0, CHUNK)))
+        .unwrap();
+    channel.channel_processor_downcast_mut::<Recorder>().unwrap().context = Some(1);
+    channel
+        .process(&frame(u32::try_from(3 * CHUNK).unwrap(), 0, &pattern(0, CHUNK)))
+        .unwrap();
+    let replies = channel
+        .process(&frame(u32::try_from(3 * CHUNK).unwrap(), LAST, &pattern(0, CHUNK)))
+        .unwrap();
+    assert!(replies.is_empty());
+    assert!(recorder_of(&channel).oversized.is_empty());
+}
+
+// oracle: mutant skipping fragment validation while discarding.
+#[test]
+fn discarded_fragments_are_still_validated() {
+    let declared = u32::try_from(3 * CHUNK).unwrap();
+
+    let mut channel = new_channel(CHUNK, OversizedMessagePolicy::Discard);
+    channel.process(&frame(declared, FIRST, &pattern(0, CHUNK))).unwrap();
+    assert!(channel.process(&frame(declared + 1, 0, &pattern(0, CHUNK))).is_err());
+
+    let mut channel = new_channel(CHUNK, OversizedMessagePolicy::Discard);
+    channel.process(&frame(declared, FIRST, &pattern(0, CHUNK))).unwrap();
+    channel.process(&frame(declared, 0, &pattern(0, CHUNK))).unwrap();
+    channel.process(&frame(declared, 0, &pattern(0, CHUNK))).unwrap();
+    // A fragment past the declared length fails before the terminal one.
+    assert!(channel.process(&frame(declared, 0, &pattern(0, 1))).is_err());
+    assert!(recorder_of(&channel).oversized.is_empty());
+
+    // A terminal fragment short of the declared length fails as for a kept message.
+    let mut channel = new_channel(CHUNK, OversizedMessagePolicy::Discard);
+    channel.process(&frame(declared, FIRST, &pattern(0, CHUNK))).unwrap();
+    assert!(channel.process(&frame(declared, LAST, &pattern(0, CHUNK))).is_err());
+    assert!(recorder_of(&channel).oversized.is_empty());
+}
