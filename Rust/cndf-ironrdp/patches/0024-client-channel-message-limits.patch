--- /dev/null
+++ b/crates/ironrdp-dvc/tests/client_limits.rs
@@ -0,0 +1,277 @@
+//! Client limits on open dynamic channels and on the messages of channels without a limit of their own.
+
+use std::alloc::{GlobalAlloc, Layout, System};
+use std::cell::Cell;
+
+use ironrdp_bulk as _;
+use ironrdp_core::{Decode as _, ReadCursor, encode_vec};
+use ironrdp_dvc::pdu::{
+    ClosePdu, CreateRequestPdu, CreationStatus, DataFirstPdu, DataPdu, DrdynvcClientPdu, DrdynvcDataPdu,
+    DrdynvcServerPdu,
+};
+use ironrdp_dvc::{
+    DrdynvcClient, DvcClientProcessor, DvcMessage, DvcProcessor, MAX_ACTIVE_CHANNELS, MAX_CHANNELS_PER_NAME,
+};
+use ironrdp_pdu::PduResult;
+use ironrdp_svc::SvcProcessor as _;
+use tracing as _;
+
+/// Counts the bytes each thread holds, so tests running in parallel do not disturb each other.
+struct CountingAllocator;
+
+thread_local! {
+    static HELD: Cell<isize> = const { Cell::new(0) };
+}
+
+fn track(delta: isize) {
+    let _ = HELD.try_with(|held| held.set(held.get() + delta));
+}
+
+// SAFETY: Forwards to the system allocator and only counts.
+unsafe impl GlobalAlloc for CountingAllocator {
+    unsafe fn alloc(&self, layout: Layout) -> *mut u8 {
+        // SAFETY: Same contract as the caller's.
+        let ptr = unsafe { System.alloc(layout) };
+        if !ptr.is_null() {
+            track(layout.size().cast_signed());
+        }
+        ptr
+    }
+
+    unsafe fn alloc_zeroed(&self, layout: Layout) -> *mut u8 {
+        // SAFETY: Same contract as the caller's.
+        let ptr = unsafe { System.alloc_zeroed(layout) };
+        if !ptr.is_null() {
+            track(layout.size().cast_signed());
+        }
+        ptr
+    }
+
+    unsafe fn dealloc(&self, ptr: *mut u8, layout: Layout) {
+        // SAFETY: Same contract as the caller's.
+        unsafe { System.dealloc(ptr, layout) };
+        track(-layout.size().cast_signed());
+    }
+
+    unsafe fn realloc(&self, ptr: *mut u8, layout: Layout, new_size: usize) -> *mut u8 {
+        // SAFETY: Same contract as the caller's.
+        let new_ptr = unsafe { System.realloc(ptr, layout, new_size) };
+        if !new_ptr.is_null() {
+            track(new_size.cast_signed() - layout.size().cast_signed());
+        }
+        new_ptr
+    }
+}
+
+#[global_allocator]
+static ALLOCATOR: CountingAllocator = CountingAllocator;
+
+fn held() -> isize {
+    HELD.with(Cell::get)
+}
+
+struct Sink {
+    name: &'static str,
+    limit: Option<usize>,
+}
+
+ironrdp_core::impl_as_any!(Sink);
+
+impl DvcProcessor for Sink {
+    fn channel_name(&self) -> &str {
+        self.name
+    }
+
+    fn max_message_size(&self) -> Option<usize> {
+        self.limit
+    }
+
+    fn start(&mut self, _: u32) -> PduResult<Vec<DvcMessage>> {
+        Ok(Vec::new())
+    }
+
+    fn process(&mut self, _: u32, _: &[u8]) -> PduResult<Vec<DvcMessage>> {
+        Ok(Vec::new())
+    }
+}
+
+impl DvcClientProcessor for Sink {}
+
+const NAME: &str = "test::factory";
+
+fn names() -> impl Iterator<Item = &'static str> {
+    (0..64).map(|i| &*Box::leak(format!("test::factory{i}").into_boxed_str()))
+}
+
+fn factory_client() -> DrdynvcClient {
+    DrdynvcClient::new().with_dynamic_channel_factory(NAME, || Sink {
+        name: NAME,
+        limit: None,
+    })
+}
+
+/// Sends a Create Request and returns the creation status of the client's response.
+fn create(client: &mut DrdynvcClient, channel_id: u32, name: &str) -> CreationStatus {
+    let request = encode_vec(&DrdynvcServerPdu::Create(CreateRequestPdu::new(
+        channel_id,
+        name.to_owned(),
+    )))
+    .unwrap();
+    let responses = client.process(&request).unwrap();
+    responses
+        .iter()
+        .find_map(|response| {
+            let bytes = response.encode_unframed_pdu().unwrap();
+            match DrdynvcClientPdu::decode(&mut ReadCursor::new(&bytes)).unwrap() {
+                DrdynvcClientPdu::Create(response) => Some(response.creation_status()),
+                _ => None,
+            }
+        })
+        .expect("a Create Response")
+}
+
+fn close(client: &mut DrdynvcClient, channel_id: u32) {
+    let request = encode_vec(&DrdynvcServerPdu::Close(ClosePdu::new(channel_id))).unwrap();
+    client.process(&request).unwrap();
+}
+
+fn data(client: &mut DrdynvcClient, pdu: DrdynvcDataPdu) -> PduResult<()> {
+    client.process(&encode_vec(&pdu).unwrap()).map(drop)
+}
+
+// oracle: mutant without the per-name limit, off by one at it, or not counting a closed channel back.
+#[test]
+fn a_factory_opens_at_most_two_channels_at_once() {
+    assert_eq!(MAX_CHANNELS_PER_NAME, 2);
+    let mut client = factory_client();
+    assert_eq!(create(&mut client, 1, NAME), CreationStatus::OK);
+    assert_eq!(create(&mut client, 2, NAME), CreationStatus::OK);
+    assert_eq!(create(&mut client, 3, NAME), CreationStatus::NO_LISTENER);
+
+    // Data the server sent on the declined channel is dropped, as for any declined channel.
+    data(&mut client, DrdynvcDataPdu::Data(DataPdu::new(3, vec![1]))).unwrap();
+
+    // A Create Request reusing an open channel's ID replaces it.
+    assert_eq!(create(&mut client, 2, NAME), CreationStatus::OK);
+
+    // Closing a channel makes room for another.
+    close(&mut client, 1);
+    assert_eq!(create(&mut client, 4, NAME), CreationStatus::OK);
+    assert_eq!(create(&mut client, 5, NAME), CreationStatus::NO_LISTENER);
+}
+
+// oracle: mutant without the total limit, or off by one at it.
+#[test]
+fn a_client_opens_at_most_64_channels_at_once() {
+    assert_eq!(MAX_ACTIVE_CHANNELS, 64);
+    let mut client = DrdynvcClient::new();
+    let names: Vec<_> = names().collect();
+    for name in &names {
+        let name: &'static str = name;
+        client = client.with_dynamic_channel_factory(name, move || Sink { name, limit: None });
+    }
+    let mut id = 0;
+    for name in names.iter().take(MAX_ACTIVE_CHANNELS / 2) {
+        for _ in 0..2 {
+            id += 1;
+            assert_eq!(create(&mut client, id, name), CreationStatus::OK, "channel {id}");
+        }
+    }
+    assert_eq!(
+        create(&mut client, 1000, names[MAX_ACTIVE_CHANNELS / 2]),
+        CreationStatus::NO_LISTENER
+    );
+    close(&mut client, 1);
+    assert_eq!(
+        create(&mut client, 1001, names[MAX_ACTIVE_CHANNELS / 2]),
+        CreationStatus::OK
+    );
+}
+
+// oracle: mutant holding a processor for every Create Request of one name.
+#[test]
+fn a_create_request_flood_holds_two_channels() {
+    let mut client = factory_client();
+    assert_eq!(create(&mut client, 1, NAME), CreationStatus::OK);
+    assert_eq!(create(&mut client, 2, NAME), CreationStatus::OK);
+    let start = held();
+    let mut opened = 0;
+    for id in 3..20_003 {
+        opened += usize::from(create(&mut client, id, NAME) == CreationStatus::OK);
+    }
+    let grown = held() - start;
+    println!("held after 20000 more Create Requests: {grown} B");
+    assert_eq!(opened, 0);
+    // Only the remembered declines (64 at most) remain.
+    assert!(grown <= 16 * 1024, "held {grown} more bytes");
+}
+
+// oracle: mutant ignoring the default limit, or letting it override a processor's own limit.
+#[test]
+fn the_default_limit_bounds_channels_without_their_own() {
+    const LIMIT: usize = 4096;
+    let mut client = DrdynvcClient::new()
+        .with_default_max_message_size(LIMIT)
+        .with_dynamic_channel_factory(NAME, || Sink {
+            name: NAME,
+            limit: None,
+        })
+        .with_dynamic_channel_factory("test::own", || Sink {
+            name: "test::own",
+            limit: Some(4 * LIMIT),
+        });
+    assert_eq!(create(&mut client, 1, NAME), CreationStatus::OK);
+    assert_eq!(create(&mut client, 2, "test::own"), CreationStatus::OK);
+
+    // At the limit, a fragmented message is accepted.
+    data(
+        &mut client,
+        DrdynvcDataPdu::DataFirst(DataFirstPdu::new(1, u32::try_from(LIMIT).unwrap(), vec![0; 1000])),
+    )
+    .unwrap();
+    data(
+        &mut client,
+        DrdynvcDataPdu::Data(DataPdu::new(1, vec![0; LIMIT - 1000])),
+    )
+    .unwrap();
+    // One byte over, it fails the channel.
+    let over = DataFirstPdu::new(1, u32::try_from(LIMIT + 1).unwrap(), vec![0; 1000]);
+    assert!(data(&mut client, DrdynvcDataPdu::DataFirst(over)).is_err());
+
+    // A processor's own limit is kept.
+    let own = DataFirstPdu::new(2, u32::try_from(4 * LIMIT).unwrap(), vec![0; 1000]);
+    data(&mut client, DrdynvcDataPdu::DataFirst(own)).unwrap();
+
+    // Without a default, the processor without a limit takes any declared length.
+    let mut client = factory_client();
+    assert_eq!(create(&mut client, 1, NAME), CreationStatus::OK);
+    data(
+        &mut client,
+        DrdynvcDataPdu::DataFirst(DataFirstPdu::new(1, u32::MAX, vec![0; 1000])),
+    )
+    .unwrap();
+}
+
+// oracle: mutant retaining a message declared over the default limit.
+#[test]
+fn a_message_declared_over_the_default_limit_holds_nothing() {
+    let mut client = DrdynvcClient::new()
+        .with_default_max_message_size(1024 * 1024)
+        .with_dynamic_channel_factory(NAME, || Sink {
+            name: NAME,
+            limit: None,
+        });
+    assert_eq!(create(&mut client, 1, NAME), CreationStatus::OK);
+    let pdu = encode_vec(&DrdynvcDataPdu::DataFirst(DataFirstPdu::new(
+        1,
+        u32::MAX,
+        vec![0; 1500],
+    )))
+    .unwrap();
+    let start = held();
+    let result = client.process(&pdu).map(drop);
+    let grown = held() - start;
+    assert!(result.is_err());
+    drop(result);
+    assert!(grown <= 1024, "held {grown} bytes");
+}
