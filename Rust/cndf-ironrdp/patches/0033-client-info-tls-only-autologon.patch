+    /// CNDF: call once the TLS upgrade, its certificate validation included, has succeeded, and
+    /// before [`Self::mark_security_upgrade_as_done`].
+    ///
+    /// Confirms autologon when the server selected TLS-only security (`PROTOCOL_SSL`) and the
+    /// connection has a username and a password to log on with. Returns whether Client Info
+    /// carries them.
+    pub fn confirm_tls_only_autologon(&mut self) -> bool {
+        let ClientConnectorState::EnhancedSecurityUpgrade { selected_protocol } = self.state else {
+            return false;
+        };
+        let has_password = matches!(
+            &self.config.credentials,
+            crate::Credentials::UsernamePassword { username, password } if !username.is_empty() && !password.is_empty()
+        );
+        let allowed = self.config.autologon
+            && selected_protocol == nego::SecurityProtocol::SSL
+            && has_password
+            && !self.entra_auth
+            && !self.remote_guard
+            && self.redirection_password_cookie.is_none();
+        let Some(policy) = self.tls_only_autologon.as_mut() else {
+            return false;
+        };
+        policy.confirmed = policy.eligible && allowed;
+        policy.confirmed
+    }
+
     pub fn should_perform_security_upgrade(&self) -> bool {
