+/// CNDF: whether Client Info logs on with the configured password (see
+/// [`ClientConnector::with_tls_only_autologon`]).
+#[derive(Debug, Clone, Copy)]
+struct TlsOnlyAutologon {
+    eligible: bool,
+    confirmed: bool,
+}
+
+impl TlsOnlyAutologon {
+    /// Sends `INFO_AUTOLOGON` and the password together, or neither.
+    fn apply(self, client_info: &mut rdp::client_info::ClientInfo) {
+        use ironrdp_pdu::rdp::client_info::ClientInfoFlags;
+
+        client_info.flags.set(ClientInfoFlags::AUTOLOGON, self.confirmed);
+        if !self.confirmed {
+            client_info.credentials.password.clear();
+        }
+    }
+}
