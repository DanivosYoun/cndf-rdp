+//! A dynamic channel message over its size limit fails with a cause that names the channel and the limit.
+
+use core::error::Error;
+
+use ironrdp_bulk as _;
+use ironrdp_core::encode_vec;
+use ironrdp_dvc::pdu::{CreateRequestPdu, DataFirstPdu, DataPdu, DrdynvcDataPdu, DrdynvcServerPdu};
+use ironrdp_dvc::{DrdynvcClient, DvcClientProcessor, DvcMessage, DvcProcessor};
+use ironrdp_pdu::PduResult;
+use ironrdp_svc::{MessageSizeLimitExceeded, SvcProcessor as _};
+use tracing as _;
+
+const NAME: &str = "test::limited";
+const LIMIT: usize = 64;
+
+struct Limited;
+
+ironrdp_core::impl_as_any!(Limited);
+
+impl DvcProcessor for Limited {
+    fn channel_name(&self) -> &str {
+        NAME
+    }
+
+    fn max_message_size(&self) -> Option<usize> {
+        Some(LIMIT)
+    }
+
+    fn start(&mut self, _: u32) -> PduResult<Vec<DvcMessage>> {
+        Ok(Vec::new())
+    }
+
+    fn process(&mut self, _: u32, _: &[u8]) -> PduResult<Vec<DvcMessage>> {
+        Ok(Vec::new())
+    }
+}
+
+impl DvcClientProcessor for Limited {}
+
+fn opened() -> DrdynvcClient {
+    let mut client = DrdynvcClient::new().with_dynamic_channel_factory(NAME, || Limited);
+    let create = encode_vec(&DrdynvcServerPdu::Create(CreateRequestPdu::new(1, NAME.to_owned()))).unwrap();
+    client.process(&create).unwrap();
+    client
+}
+
+fn send(client: &mut DrdynvcClient, pdu: DrdynvcDataPdu) -> PduResult<()> {
+    let bytes = encode_vec(&DrdynvcServerPdu::Data(pdu)).unwrap();
+    client.process(&bytes).map(drop)
+}
+
+fn limit_cause(mut error: &(dyn Error + 'static)) -> Option<MessageSizeLimitExceeded> {
+    loop {
+        if let Some(cause) = error.downcast_ref::<MessageSizeLimitExceeded>() {
+            return Some(cause.clone());
+        }
+        error = error.source()?;
+    }
+}
+
+fn expected() -> Option<MessageSizeLimitExceeded> {
+    Some(MessageSizeLimitExceeded {
+        channel: NAME.to_owned(),
+        limit: LIMIT,
+    })
+}
+
+// oracle: mutant dropping the cause at either limit check.
+#[test]
+fn each_limit_check_names_the_channel_and_the_limit() {
+    let mut client = opened();
+    let over = DataFirstPdu::new(1, u32::try_from(LIMIT + 1).unwrap(), vec![0; 8]);
+    let error = send(&mut client, DrdynvcDataPdu::DataFirst(over)).unwrap_err();
+    assert_eq!(limit_cause(&error), expected());
+
+    let mut client = opened();
+    let error = send(&mut client, DrdynvcDataPdu::Data(DataPdu::new(1, vec![0; LIMIT + 1]))).unwrap_err();
+    assert_eq!(limit_cause(&error), expected());
+}
+
+// oracle: mutant attaching the cause to errors that are not about the size limit.
+#[test]
+fn other_reassembly_errors_carry_no_limit_cause() {
+    let mut client = opened();
+    let first = DataFirstPdu::new(1, 16, vec![0; 8]);
+    send(&mut client, DrdynvcDataPdu::DataFirst(first)).unwrap();
+    let error = send(&mut client, DrdynvcDataPdu::Data(DataPdu::new(1, vec![0; 9]))).unwrap_err();
+    assert_eq!(limit_cause(&error), None);
+}
