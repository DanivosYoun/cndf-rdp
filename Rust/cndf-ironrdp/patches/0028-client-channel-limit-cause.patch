index 0000000..70c4f9b
--- /dev/null
+++ b/crates/ironrdp-svc/tests/limit_cause.rs
@@ -0,0 +1,83 @@
+//! A static channel message over its size limit fails with a cause that names the channel and the limit.
+
+use core::error::Error;
+
+use bitflags as _;
+use ironrdp_pdu::PduResult;
+use ironrdp_pdu::gcc::ChannelName;
+use ironrdp_svc::{MessageSizeLimitExceeded, StaticVirtualChannel, SvcMessage, SvcProcessor};
+
+const FIRST: u32 = 1;
+const LAST: u32 = 2;
+const LIMIT: usize = 8;
+
+#[derive(Debug)]
+struct Limited;
+
+ironrdp_core::impl_as_any!(Limited);
+
+impl SvcProcessor for Limited {
+    fn channel_name(&self) -> ChannelName {
+        ChannelName::from_static(b"testcap\0")
+    }
+
+    fn max_message_size(&self) -> Option<usize> {
+        Some(LIMIT)
+    }
+
+    fn process(&mut self, _: &[u8]) -> PduResult<Vec<SvcMessage>> {
+        Ok(Vec::new())
+    }
+}
+
+fn frame(length: usize, flags: u32, data: &[u8]) -> Vec<u8> {
+    let mut bytes = u32::try_from(length).unwrap().to_le_bytes().to_vec();
+    bytes.extend_from_slice(&flags.to_le_bytes());
+    bytes.extend_from_slice(data);
+    bytes
+}
+
+fn limit_cause(mut error: &(dyn Error + 'static)) -> Option<MessageSizeLimitExceeded> {
+    loop {
+        if let Some(cause) = error.downcast_ref::<MessageSizeLimitExceeded>() {
+            return Some(cause.clone());
+        }
+        error = error.source()?;
+    }
+}
+
+fn expected() -> Option<MessageSizeLimitExceeded> {
+    Some(MessageSizeLimitExceeded {
+        channel: "testcap".to_owned(),
+        limit: LIMIT,
+    })
+}
+
+// oracle: mutant dropping the cause at any of the limit checks.
+#[test]
+fn each_limit_check_names_the_channel_and_the_limit() {
+    // One unfragmented chunk over the limit.
+    let mut channel = StaticVirtualChannel::new(Limited);
+    let error = channel.process(&frame(LIMIT + 1, FIRST | LAST, &[0; LIMIT + 1])).unwrap_err();
+    assert_eq!(limit_cause(&error), expected());
+
+    // A first fragment that declares more than the limit.
+    let mut channel = StaticVirtualChannel::new(Limited);
+    let error = channel.process(&frame(LIMIT + 1, FIRST, &[0; 4])).unwrap_err();
+    assert_eq!(limit_cause(&error), expected());
+
+    // Fragments whose bytes pass the limit before the declared length catches them.
+    let mut channel = StaticVirtualChannel::new(Limited);
+    assert!(channel.process(&frame(LIMIT, FIRST, &[0; 4])).unwrap().is_empty());
+    let error = channel.process(&frame(LIMIT, 0, &[0; 6])).unwrap_err();
+    assert_eq!(limit_cause(&error), expected());
+}
+
+// oracle: mutant attaching the cause to errors that are not about the size limit.
+#[test]
+fn other_reassembly_errors_carry_no_limit_cause() {
+    let mut channel = StaticVirtualChannel::new(Limited);
+    assert!(channel.process(&frame(LIMIT, FIRST, &[0; 4])).unwrap().is_empty());
+    let error = channel.process(&frame(LIMIT - 1, LAST, &[0; 3])).unwrap_err();
+    assert_eq!(limit_cause(&error), None);
+}
