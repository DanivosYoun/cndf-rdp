+/// Each server frame ends with a desktop update marked as the frame end, and the screen
+/// composed up to that update is the whole frame.
+#[test]
+fn each_server_frame_ends_with_a_marked_update() {
+    run_local(|| async {
+        let frames = 3;
+        let mut session = start(1024, 1024, vec![Step::Frame; frames], 128, None).await;
+        for frame in 0..frames {
+            session.release.send_modify(|released| *released += 1);
+            let mut last = None;
+            // The frame has been processed once no event arrives for a second.
+            while let Ok(event) = tokio::time::timeout(Duration::from_secs(1), session.output.recv()).await {
+                let event = event.expect("the client is running");
+                if let RdpOutputEvent::DesktopUpdate(update) = &event {
+                    last = Some(update.ends_frame());
+                }
+                session.compose(event);
+            }
+            assert_eq!(session.sent.load(Ordering::SeqCst), frame + 1);
+            assert_eq!(last, Some(true), "frame {frame} ends with a marked update");
+            assert!(session.screen == screen(frame, 1024 * 1024), "frame {frame} is composed");
+        }
+        session.input.request_close();
+        session.server.abort();
+        drop(session.output);
+        let _ = tokio::time::timeout(Duration::from_secs(5), session.client).await;
+    });
+}
+
 /// A close while the session loop waits for budget ends the session within a second, and so
 /// does a graceful close, which still reaches the server (it disconnects on a shutdown request),
 /// with the consumer stalled throughout.
