+#[test]
+fn desktop_update_permits_hold_their_bytes_until_dropped() {
+    let (sender, _receiver) = output_channel(1);
+    let first = sender
+        .__test_try_reserve_desktop_update(6, 10)
+        .expect("room for the first update");
+    assert!(
+        sender.__test_try_reserve_desktop_update(5, 10).is_none(),
+        "6 + 5 bytes exceed the budget"
+    );
+    let second = sender
+        .__test_try_reserve_desktop_update(4, 10)
+        .expect("6 + 4 bytes fit exactly");
+    drop(first);
+    assert!(
+        sender.__test_try_reserve_desktop_update(7, 10).is_none(),
+        "4 bytes are still held"
+    );
+    assert!(sender.__test_try_reserve_desktop_update(6, 10).is_some());
+    drop(second);
+    assert_eq!(sender.__test_desktop_update_bytes_in_flight(), 0);
+}
+
+#[test]
+fn desktop_update_budget_follows_the_limit_of_each_request() {
+    let (sender, _receiver) = output_channel(1);
+    let held = sender.__test_try_reserve_desktop_update(8, 10).expect("room");
+    assert!(sender.__test_try_reserve_desktop_update(8, 10).is_none());
+    // A larger framebuffer raises the budget for the updates packed after it.
+    assert!(sender.__test_try_reserve_desktop_update(8, 16).is_some());
+    drop(held);
+}
+
+#[test]
+fn desktop_update_larger_than_the_budget_takes_all_of_it() {
+    let (sender, _receiver) = output_channel(1);
+    let small = sender.__test_try_reserve_desktop_update(1, 10).expect("room");
+    assert!(
+        sender.__test_try_reserve_desktop_update(25, 10).is_none(),
+        "an oversized update waits for the budget to drain"
+    );
+    drop(small);
+    let large = sender
+        .__test_try_reserve_desktop_update(25, 10)
+        .expect("an oversized update passes alone");
+    assert_eq!(
+        sender.__test_desktop_update_bytes_in_flight(),
+        10,
+        "it holds the whole budget"
+    );
+    drop(large);
+    assert!(
+        sender.__test_try_reserve_desktop_update(10, 10).is_some(),
+        "and returns all of it"
+    );
+}
+
+#[tokio::test]
+async fn desktop_update_reservation_waits_for_a_release() {
