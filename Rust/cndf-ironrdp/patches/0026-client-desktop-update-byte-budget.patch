+/// The budget follows the framebuffer: after a resize to 4096x2048 (32 MiB frames) the client
+/// lets up to 64 MiB of updates wait, not the 32 MiB of the 1024x1024 desktop it connected with.
+#[test]
+fn budget_follows_a_desktop_resize() {
+    run_local(|| async {
+        let mut steps = vec![Step::Frame, Step::Resize(4096, 2048)];
+        steps.extend(vec![Step::Frame; 12]);
+        let total = steps.len();
+        let (probe_tx, probe_rx) = oneshot::channel();
+        let mut session = start(1024, 1024, steps, 128, Some(probe_tx)).await;
+        let probe = probe_rx.await.unwrap();
+        // Let the first frame, the resize and a frame at the new size through while consuming.
+        session.release.send_modify(|released| *released = 3);
+        tokio::time::timeout(Duration::from_secs(20), async {
+            while session.extent != (4096, 2048) {
+                let event = session.output.recv().await.expect("the client is running");
+                session.compose(event);
+            }
+        })
+        .await
+        .expect("the client resizes");
+        let base = CURRENT.load(Ordering::Relaxed);
+        let held = session.stall(total - 3, base).await;
+        let waiting = probe.__test_desktop_update_bytes_in_flight();
+        println!("after resize: waiting={} MiB held={} MiB", mib(waiting), mib(held));
+        // Tiles are at most 8 MiB, so a 64 MiB budget stalls above 56 MiB and a 32 MiB one below 32.
+        assert!(
+            waiting > 40 * MIB,
+            "{waiting} bytes wait: the budget did not grow with the framebuffer"
+        );
+        assert!(waiting <= 64 * MIB, "{waiting} bytes wait, more than the 64 MiB budget");
+        let frame = 4096 * 2048 * 4;
+        assert!(
+            held <= 64 * MIB + 3 * frame,
+            "held {held} bytes, more than the 64 MiB budget"
+        );
+        session.input.request_close();
+        session.server.abort();
+        drop(session.output);
+        let _ = tokio::time::timeout(Duration::from_secs(5), session.client).await;
+    });
+}
