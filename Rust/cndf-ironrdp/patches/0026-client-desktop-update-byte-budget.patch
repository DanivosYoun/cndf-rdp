+//! Bytes of desktop updates an `RdpClient` holds while its embedder stops consuming them.
+//!
+//! The server sends full-frame bitmaps of fresh noise each time and the embedder does not
+//! read the output channel. Held bytes come from a counting global allocator, so this file is its
+//! own test binary and its tests run one at a time.
+
+#![allow(unused_crate_dependencies)]
+#![allow(clippy::unwrap_used, reason = "unwrap is fine in tests")]
+#![allow(clippy::print_stdout, reason = "the measurement is reported")]
+
+use core::alloc::{GlobalAlloc, Layout};
+use core::num::{NonZeroU16, NonZeroUsize};
+use core::sync::atomic::{AtomicUsize, Ordering};
+use core::time::Duration;
+use std::alloc::System;
+use std::path::Path;
+use std::sync::{Arc, Mutex as StdMutex};
+
+use ironrdp::pdu::rdp::capability_sets::MajorPlatformType;
+use ironrdp::server::{
+    self, DesktopSize, DisplayContext, DisplayUpdate, KeyboardEvent, MouseEvent, PixelFormat, RdpServer,
+    RdpServerDisplay, RdpServerDisplayUpdates, RdpServerInputHandler, ServerEvent, ServerResult, TlsIdentityCtx,
+};
+use ironrdp_client::config::{ConfigBuilder, Destination};
+use ironrdp_client::output_channel::{OutputEventReceiver, output_channel};
+use ironrdp_client::rdp::{RdpClient, RdpOutputEvent};
+use tokio::sync::{oneshot, watch};
+
+struct Counting;
+static CURRENT: AtomicUsize = AtomicUsize::new(0);
+
+// SAFETY: forwards every call to `System` and only counts the sizes.
+unsafe impl GlobalAlloc for Counting {
+    unsafe fn alloc(&self, layout: Layout) -> *mut u8 {
+        // SAFETY: same contract as the caller's.
+        let ptr = unsafe { System.alloc(layout) };
+        if !ptr.is_null() {
+            CURRENT.fetch_add(layout.size(), Ordering::Relaxed);
+        }
+        ptr
+    }
+    unsafe fn alloc_zeroed(&self, layout: Layout) -> *mut u8 {
+        // SAFETY: same contract as the caller's.
+        let ptr = unsafe { System.alloc_zeroed(layout) };
+        if !ptr.is_null() {
+            CURRENT.fetch_add(layout.size(), Ordering::Relaxed);
+        }
+        ptr
+    }
+    unsafe fn dealloc(&self, ptr: *mut u8, layout: Layout) {
+        // SAFETY: same contract as the caller's.
+        unsafe { System.dealloc(ptr, layout) };
+        CURRENT.fetch_sub(layout.size(), Ordering::Relaxed);
+    }
+    unsafe fn realloc(&self, ptr: *mut u8, layout: Layout, new_size: usize) -> *mut u8 {
+        // SAFETY: same contract as the caller's.
+        let new = unsafe { System.realloc(ptr, layout, new_size) };
+        if !new.is_null() {
+            CURRENT.fetch_sub(layout.size(), Ordering::Relaxed);
+            CURRENT.fetch_add(new_size, Ordering::Relaxed);
+        }
+        new
+    }
+}
+
+#[global_allocator]
+static ALLOCATOR: Counting = Counting;
+
+/// One measurement at a time: the counter is process-wide.
+static SERIAL: StdMutex<()> = StdMutex::new(());
+
+const MIB: usize = 1024 * 1024;
+
+/// `bytes` in MiB with one decimal.
+fn mib(bytes: usize) -> String {
+    format!("{}.{}", bytes / MIB, bytes % MIB * 10 / MIB)
+}
+const USER: &str = "user";
+const PASSWORD: &str = "password";
+
+/// Noise no encoder can shrink, different in every frame, so each is a full-frame update.
+fn frame_data(frame: usize, pixels: usize) -> Vec<u8> {
+    let mut state = 0x2545_f491_4f6c_dd1du64 ^ (u64::try_from(frame).unwrap() + 1).wrapping_mul(0x9e37_79b9_7f4a_7c15);
+    let mut data = Vec::with_capacity(pixels * 4);
+    for _ in 0..pixels {
+        state ^= state << 13;
+        state ^= state >> 7;
+        state ^= state << 17;
+        let [b, g, r, ..] = state.to_le_bytes();
+        data.extend_from_slice(&[b, g, r, 0xff]);
+    }
+    data
+}
+
+/// What the display sends, in order, as the server asks for it.
+#[derive(Clone)]
+enum Step {
+    Frame,
+    Resize(u16, u16),
+}
+
+struct Script {
+    steps: Vec<Step>,
+    /// Released step count; the server waits once it has sent them all.
+    released: watch::Receiver<usize>,
+    sent: Arc<AtomicUsize>,
+    size: Arc<StdMutex<(u16, u16)>>,
+}
+
+struct ScriptedUpdates {
+    script: Arc<tokio::sync::Mutex<Script>>,
+}
+
+#[async_trait::async_trait]
+impl RdpServerDisplayUpdates for ScriptedUpdates {
+    async fn next_update(&mut self) -> ServerResult<Option<DisplayUpdate>> {
+        let mut script = self.script.lock().await;
+        let index = script.sent.load(Ordering::SeqCst);
+        if index >= script.steps.len() {
+            return Ok(core::future::pending().await);
+        }
+        let _ = script.released.wait_for(|released| *released > index).await;
+        let step = script.steps[index].clone();
+        let update = match step {
+            Step::Frame => {
+                let (width, height) = *script.size.lock().unwrap();
+                let pixels = usize::from(width) * usize::from(height);
+                let data = frame_data(index, pixels);
+                DisplayUpdate::Bitmap(server::BitmapUpdate {
+                    x: 0,
+                    y: 0,
+                    width: NonZeroU16::new(width).unwrap(),
+                    height: NonZeroU16::new(height).unwrap(),
+                    format: PixelFormat::BgrA32,
+                    data: data.into(),
+                    stride: NonZeroUsize::new(usize::from(width) * 4).unwrap(),
+                })
+            }
+            Step::Resize(width, height) => {
+                *script.size.lock().unwrap() = (width, height);
+                DisplayUpdate::Resize(DesktopSize { width, height })
+            }
+        };
+        script.sent.store(index + 1, Ordering::SeqCst);
+        Ok(Some(update))
+    }
+}
+
+struct ScriptedDisplay {
+    script: Arc<tokio::sync::Mutex<Script>>,
+    size: Arc<StdMutex<(u16, u16)>>,
+}
+
+#[async_trait::async_trait]
+impl RdpServerDisplay for ScriptedDisplay {
+    async fn size(&mut self) -> DesktopSize {
+        let (width, height) = *self.size.lock().unwrap();
+        DesktopSize { width, height }
+    }
+
+    async fn updates(&mut self, _: DisplayContext) -> ServerResult<Box<dyn RdpServerDisplayUpdates>> {
+        Ok(Box::new(ScriptedUpdates {
+            script: Arc::clone(&self.script),
+        }))
+    }
+}
+
+struct NoInput;
+impl RdpServerInputHandler for NoInput {
+    fn keyboard(&mut self, _: KeyboardEvent) {}
+    fn mouse(&mut self, _: MouseEvent) {}
+}
+
+struct Session {
+    output: OutputEventReceiver,
+    input: ironrdp_client::rdp::RdpInputSender,
+    client: tokio::task::JoinHandle<()>,
+    server: tokio::task::JoinHandle<()>,
+    release: watch::Sender<usize>,
+    sent: Arc<AtomicUsize>,
+    /// The client's framebuffer as composed from the desktop updates received so far.
+    screen: Vec<u32>,
+    extent: (u16, u16),
+}
+
+/// Starts a server that plays `steps` as they are released and a client with desktop updates on,
+/// and waits until the client is connected.
+async fn start(
+    width: u16,
+    height: u16,
+    steps: Vec<Step>,
+    capacity: usize,
+    probe: Option<oneshot::Sender<ironrdp_client::output_channel::OutputEventSender>>,
+) -> Session {
+    let cert = Path::new(env!("CARGO_MANIFEST_DIR")).join("tests/certs/server-cert.pem");
+    let key = Path::new(env!("CARGO_MANIFEST_DIR")).join("tests/certs/server-key.pem");
+    let identity = TlsIdentityCtx::init_from_paths(&cert, &key).unwrap();
+    let acceptor = identity.make_acceptor().unwrap();
+    let size = Arc::new(StdMutex::new((width, height)));
+    let (release, released) = watch::channel(0);
+    let sent = Arc::new(AtomicUsize::new(0));
+    let script = Arc::new(tokio::sync::Mutex::new(Script {
+        steps,
+        released,
+        sent: Arc::clone(&sent),
+        size: Arc::clone(&size),
+    }));
+    let mut server = RdpServer::builder()
+        .with_addr(([127, 0, 0, 1], 0))
+        .with_hybrid(acceptor, identity.pub_key)
+        .with_input_handler(NoInput)
+        .with_display_handler(ScriptedDisplay { script, size })
+        .build();
+    server.set_credentials(Some(server::Credentials {
+        username: USER.into(),
+        password: PASSWORD.into(),
+        domain: None,
+    }));
+    let events = server.event_sender().clone();
+    let server = tokio::task::spawn_local(async move {
+        let _ = server.run().await;
+    });
+    let (tx, rx) = oneshot::channel();
+    events.send(ServerEvent::GetLocalAddr(tx)).unwrap();
+    let addr = rx.await.unwrap().unwrap();
+
+    let config = ConfigBuilder::new()
+        .with_destination(Destination::from_parts("127.0.0.1", addr.port()))
+        .with_username(USER)
+        .with_password(PASSWORD)
+        .with_desktop_width(width)
+        .with_desktop_height(height)
+        .with_client_build(1)
+        .with_client_dir("C:\\")
+        .with_platform(MajorPlatformType::WINDOWS)
+        .with_client_name("client")
+        .with_clipboard(ironrdp_client::config::ClipboardType::Disable)
+        // As the CNDF engine configures it: the server draws the pointer.
+        .with_server_pointer(true)
+        .with_pointer_software_rendering(false)
+        .with_graphics_pipeline(false)
+        // Lossless bitmaps, so the composed screen can be compared with the server's frames.
+        .with_codecs(vec![
+            "remotefx:off".to_owned(),
+            "qoi:off".to_owned(),
+            "qoiz:off".to_owned(),
+        ])
+        .build()
+        .unwrap();
+    let (output_tx, output) = output_channel(capacity);
+    if let Some(probe) = probe {
+        let _ = probe.send(output_tx.clone());
+    }
+    let client = RdpClient::new(config, output_tx).with_desktop_updates();
+    let input = client.input_sender();
+    let client = tokio::task::spawn_local(client.run());
+    let mut session = Session {
+        output,
+        input,
+        client,
+        server,
+        release,
+        sent,
+        screen: Vec::new(),
+        extent: (0, 0),
+    };
+    session
+        .drain_until(Duration::from_secs(20), |event| {
+            matches!(event, RdpOutputEvent::Connected)
+        })
+        .await;
+    session
+}
+
+impl Session {
+    fn compose(&mut self, event: RdpOutputEvent) {
+        if let RdpOutputEvent::DesktopUpdate(update) = event {
+            let extent = (update.width().get(), update.height().get());
+            if extent != self.extent {
+                self.extent = extent;
+                self.screen = vec![0; usize::from(extent.0) * usize::from(extent.1)];
+            }
+            let region = update.region();
+            let row = usize::from(region.right - region.left) + 1;
+            for (i, pixels) in update.buffer().chunks_exact(row).enumerate() {
+                let start = (usize::from(region.top) + i) * usize::from(extent.0) + usize::from(region.left);
+                self.screen[start..start + row].copy_from_slice(pixels);
+            }
+        }
+    }
+
+    /// Consumes events until one matches `stop`; desktop updates are composed on the way.
+    async fn drain_until(&mut self, limit: Duration, stop: impl Fn(&RdpOutputEvent) -> bool) {
+        tokio::time::timeout(limit, async {
+            loop {
+                let event = self.output.recv().await.expect("the client is running");
+                assert!(
+                    !matches!(event, RdpOutputEvent::ConnectionFailure(_)),
+                    "the client failed: {event:?}"
+                );
+                if stop(&event) {
+                    return;
+                }
+                self.compose(event);
+            }
+        })
+        .await
+        .expect("the awaited event arrives");
+    }
+
+    /// Releases `steps` more steps and, without consuming, waits until the client stops taking any.
+    /// Returns the bytes held above `base` once nothing moves for a second.
+    async fn stall(&self, steps: usize, base: usize) -> usize {
+        self.release.send_modify(|released| *released += steps);
+        let mut last = (usize::MAX, usize::MAX);
+        let mut still = 0;
+        loop {
+            tokio::time::sleep(Duration::from_millis(100)).await;
+            let now = (self.sent.load(Ordering::SeqCst), CURRENT.load(Ordering::Relaxed) / MIB);
+            if now == last {
+                still += 1;
+                if still >= 10 {
+                    return CURRENT.load(Ordering::Relaxed).saturating_sub(base);
+                }
+            } else {
+                still = 0;
+                last = now;
+            }
+        }
+    }
+}
+
+/// The `0x00RRGGBB` screen a client shows for `frame`.
+fn screen(frame: usize, pixels: usize) -> Vec<u32> {
+    frame_data(frame, pixels)
+        .chunks_exact(4)
+        .map(|bgra| u32::from_be_bytes([0, bgra[2], bgra[1], bgra[0]]))
+        .collect()
+}
+
+/// Holds the bytes of a stalled consumer after `frames` full 1024x1024 frames.
+async fn held_while_stalled(frames: usize, capacity: usize) -> usize {
+    let session = start(1024, 1024, vec![Step::Frame; frames], capacity, None).await;
+    let base = CURRENT.load(Ordering::Relaxed);
+    let held = session.stall(frames, base).await;
+    println!(
+        "capacity={capacity} frames={frames} sent={} held={} MiB",
+        session.sent.load(Ordering::SeqCst),
+        mib(held)
+    );
+    session.input.request_close();
+    session.server.abort();
+    drop(session.output);
+    let _ = tokio::time::timeout(Duration::from_secs(5), session.client).await;
+    held
+}
+
+fn run_local<F: Future<Output = ()>>(f: impl FnOnce() -> F) {
+    let _serial = SERIAL.lock().unwrap_or_else(|poisoned| poisoned.into_inner());
+    let runtime = tokio::runtime::Builder::new_current_thread()
+        .enable_all()
+        .build()
+        .unwrap();
+    let local = tokio::task::LocalSet::new();
+    local.block_on(&runtime, f());
+}
+
+/// Before the budget, a stalled consumer held as many full frames as the channel had room for.
+/// The budget for a 1024x1024 desktop is 32 MiB (eight frames) whatever the channel capacity.
+#[test]
+fn stalled_consumer_holds_at_most_the_desktop_update_budget() {
+    run_local(|| async {
+        let frame = 1024 * 1024 * 4;
+        let mut held = Vec::new();
+        for capacity in [16, 64, 128] {
+            held.push((capacity, held_while_stalled(capacity + 40, capacity).await));
+        }
+        for (capacity, held) in held {
+            // The budget, the frame being decoded, and the server's own copies of a frame or two.
+            assert!(
+                held <= 32 * MIB + 4 * frame,
+                "capacity {capacity}: held {held} bytes, more than the 32 MiB budget"
+            );
+        }
+    });
+}
+
+/// Every withheld update arrives in order once the consumer resumes, and the screen ends up as
+/// the server's last frame.
+#[test]
+fn resumed_consumer_receives_every_update_in_order() {
+    run_local(|| async {
+        let frames = 40;
+        let mut session = start(1024, 1024, vec![Step::Frame; frames], 128, None).await;
+        let base = CURRENT.load(Ordering::Relaxed);
+        session.stall(frames, base).await;
+        assert!(
+            session.sent.load(Ordering::SeqCst) < frames,
+            "the stall holds back the server"
+        );
+
+        let pixels = 1024 * 1024;
+        let expected = screen(frames - 1, pixels);
+        // Each frame is told apart by its first row, which every full-frame update starts with.
+        let firsts: Vec<Vec<u32>> = (0..frames).map(|frame| screen(frame, 1024)).collect();
+        let mut seen = Vec::new();
+        tokio::time::timeout(Duration::from_secs(60), async {
+            loop {
+                let event = session.output.recv().await.expect("the client is running");
+                if let RdpOutputEvent::DesktopUpdate(update) = &event {
+                    if update.region().left == 0 && update.region().top == 0 && update.buffer().len() >= 1024 {
+                        if let Some(frame) = firsts.iter().position(|first| first[..] == update.buffer()[..1024]) {
+                            seen.push(frame);
+                        }
+                    }
+                }
+                session.compose(event);
+                if session.sent.load(Ordering::SeqCst) == frames && session.screen == expected {
+                    return;
+                }
+            }
+        })
+        .await
+        .expect("the last frame arrives");
+        assert!(
+            seen.windows(2).all(|pair| pair[0] < pair[1]),
+            "frames out of order: {seen:?}"
+        );
+        assert_eq!(seen.last(), Some(&(frames - 1)));
+        session.input.request_close();
+        session.server.abort();
+        drop(session.output);
+        let _ = tokio::time::timeout(Duration::from_secs(5), session.client).await;
+    });
+}
+
+/// A close while the session loop waits for budget ends the session within a second, and so
+/// does a graceful close, which still reaches the server (it disconnects on a shutdown request),
+/// with the consumer stalled throughout.
+#[test]
+fn close_while_waiting_for_budget_terminates_the_session() {
+    for graceful in [false, true] {
+        run_local(|| async move {
+            let mut session = start(1024, 1024, vec![Step::Frame; 60], 128, None).await;
+            let base = CURRENT.load(Ordering::Relaxed);
+            session.stall(60, base).await;
+            if graceful {
+                session.input.request_graceful_close();
+            } else {
+                session.input.request_close();
+            }
+            tokio::time::timeout(Duration::from_secs(1), &mut session.client)
+                .await
+                .unwrap_or_else(|_| panic!("graceful={graceful}: the session waits for budget past a close"))
+                .unwrap();
+            session
+                .drain_until(Duration::from_secs(1), |event| {
+                    matches!(event, RdpOutputEvent::Terminated(_))
+                })
+                .await;
+            session.server.abort();
+        });
+    }
+}
