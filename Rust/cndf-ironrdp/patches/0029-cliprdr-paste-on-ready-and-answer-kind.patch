@@ -0,0 +1,226 @@
+use std::sync::{Arc, Mutex};
+
+use ironrdp_cliprdr::CliprdrClient;
+use ironrdp_cliprdr::backend::{CliprdrBackend, RequestedFormat};
+use ironrdp_cliprdr::pdu::{
+    Capabilities, ClipboardFormat, ClipboardFormatId, ClipboardFormatName, ClipboardGeneralCapabilityFlags,
+    ClipboardPdu, ClipboardProtocolVersion, FileContentsRequest, FileContentsResponse, FileDescriptor,
+    FormatDataRequest, FormatDataResponse, FormatList, FormatListResponse, LockDataId,
+};
+use ironrdp_core::encode_vec;
+use ironrdp_svc::{SvcMessage, SvcProcessor as _};
+use ironrdp_testsuite_core::clipboard::{HANDSHAKE_SERVER_FLAGS, real_now_ms};
+
+fn file_list_id() -> ClipboardFormatId {
+    ClipboardFormatId::new(49534)
+}
+
+#[derive(Debug, Default)]
+struct Calls {
+    ready: usize,
+    answers: Vec<(Option<RequestedFormat>, bool)>,
+}
+
+#[derive(Debug)]
+struct Backend {
+    calls: Arc<Mutex<Calls>>,
+    ready: bool,
+    deferred: Option<ClipboardFormatId>,
+}
+
+ironrdp_core::impl_as_any!(Backend);
+
+impl CliprdrBackend for Backend {
+    fn temporary_directory(&self) -> &str {
+        ""
+    }
+    fn client_capabilities(&self) -> ClipboardGeneralCapabilityFlags {
+        ClipboardGeneralCapabilityFlags::USE_LONG_FORMAT_NAMES
+            | ClipboardGeneralCapabilityFlags::STREAM_FILECLIP_ENABLED
+    }
+    fn on_ready(&mut self) {
+        self.ready = true;
+        self.calls.lock().unwrap().ready += 1;
+    }
+    fn paste_on_ready(&mut self) -> Option<ClipboardFormatId> {
+        self.on_ready();
+        self.deferred.take()
+    }
+    fn on_request_format_list(&mut self) {}
+    fn on_process_negotiated_capabilities(&mut self, _: ClipboardGeneralCapabilityFlags) {}
+    fn on_remote_copy(&mut self, _: &[ClipboardFormat]) {}
+    fn paste_on_remote_copy(&mut self, formats: &[ClipboardFormat]) -> Option<ClipboardFormatId> {
+        let choice = formats.first().map(|format| format.id);
+        if self.ready {
+            choice
+        } else {
+            self.deferred = choice;
+            None
+        }
+    }
+    fn on_format_data_request(&mut self, _: FormatDataRequest) {}
+    fn on_format_data_response(&mut self, _: FormatDataResponse<'_>) {}
+    fn on_format_data_answer(&mut self, response: FormatDataResponse<'_>, kind: Option<RequestedFormat>) {
+        self.calls.lock().unwrap().answers.push((kind, response.is_error()));
+    }
+    fn on_remote_file_list(&mut self, _: &[FileDescriptor], _: Option<u32>) {}
+    fn on_file_contents_request(&mut self, _: FileContentsRequest) {}
+    fn on_file_contents_response(&mut self, _: FileContentsResponse<'_>) {}
+    fn on_lock(&mut self, _: LockDataId) {}
+    fn on_unlock(&mut self, _: LockDataId) {}
+    fn now_ms(&self) -> u64 {
+        real_now_ms()
+    }
+}
+
+fn client() -> (CliprdrClient, Arc<Mutex<Calls>>) {
+    let calls = Arc::new(Mutex::new(Calls::default()));
+    let mut cliprdr = CliprdrClient::new(Box::new(Backend {
+        calls: Arc::clone(&calls),
+        ready: false,
+        deferred: None,
+    }));
+    cliprdr.process(&server_capabilities()).unwrap();
+    (cliprdr, calls)
+}
+
+fn pdu(pdu: ClipboardPdu<'_>) -> Vec<u8> {
+    encode_vec(&pdu).unwrap()
+}
+
+fn server_capabilities() -> Vec<u8> {
+    pdu(ClipboardPdu::Capabilities(Capabilities::new(
+        ClipboardProtocolVersion::V2,
+        HANDSHAKE_SERVER_FLAGS,
+    )))
+}
+
+fn remote_copy(formats: &[ClipboardFormat]) -> Vec<u8> {
+    pdu(ClipboardPdu::FormatList(
+        FormatList::new_unicode(formats, true).unwrap(),
+    ))
+}
+
+fn file_list_format() -> ClipboardFormat {
+    ClipboardFormat::new(file_list_id()).with_name(ClipboardFormatName::FILE_LIST)
+}
+
+fn decoded(messages: Vec<SvcMessage>) -> Vec<String> {
+    messages
+        .iter()
+        .map(|message| {
+            let bytes = message.encode_unframed_pdu().unwrap();
+            match ironrdp_core::decode::<ClipboardPdu<'_>>(&bytes).unwrap() {
+                ClipboardPdu::FormatListResponse(FormatListResponse::Ok) => "FormatListResponse::Ok".to_owned(),
+                ClipboardPdu::FormatDataRequest(request) => format!("FormatDataRequest({})", request.format.value()),
+                other => panic!("unexpected output: {other:?}"),
+            }
+        })
+        .collect()
+}
+
+fn ready(cliprdr: &mut CliprdrClient) -> Vec<String> {
+    decoded(
+        cliprdr
+            .process(&pdu(ClipboardPdu::FormatListResponse(FormatListResponse::Ok)))
+            .unwrap(),
+    )
+}
+
+fn text_format() -> ClipboardFormat {
+    ClipboardFormat::new(ClipboardFormatId::CF_UNICODETEXT)
+}
+
+#[test]
+fn ready_outputs_the_deferred_paste_once() {
+    let (mut cliprdr, calls) = client();
+    cliprdr.process(&remote_copy(&[text_format()])).unwrap();
+    assert_eq!(ready(&mut cliprdr), ["FormatDataRequest(13)"]);
+    assert!(ready(&mut cliprdr).is_empty());
+    assert_eq!(calls.lock().unwrap().ready, 1);
+}
+
+#[derive(Debug)]
+struct DefaultReadyBackend(Arc<Mutex<u32>>);
+
+ironrdp_core::impl_as_any!(DefaultReadyBackend);
+
+impl CliprdrBackend for DefaultReadyBackend {
+    fn temporary_directory(&self) -> &str {
+        ""
+    }
+    fn client_capabilities(&self) -> ClipboardGeneralCapabilityFlags {
+        ClipboardGeneralCapabilityFlags::empty()
+    }
+    fn on_ready(&mut self) {
+        *self.0.lock().unwrap() += 1;
+    }
+    fn on_request_format_list(&mut self) {}
+    fn on_process_negotiated_capabilities(&mut self, _: ClipboardGeneralCapabilityFlags) {}
+    fn on_remote_copy(&mut self, _: &[ClipboardFormat]) {}
+    fn on_format_data_request(&mut self, _: FormatDataRequest) {}
+    fn on_format_data_response(&mut self, _: FormatDataResponse<'_>) {}
+    fn on_file_contents_request(&mut self, _: FileContentsRequest) {}
+    fn on_file_contents_response(&mut self, _: FileContentsResponse<'_>) {}
+    fn on_lock(&mut self, _: LockDataId) {}
+    fn on_unlock(&mut self, _: LockDataId) {}
+    fn now_ms(&self) -> u64 {
+        real_now_ms()
+    }
+}
+
+#[test]
+fn default_backend_becomes_ready_without_output() {
+    let calls = Arc::new(Mutex::new(0));
+    let mut cliprdr = CliprdrClient::new(Box::new(DefaultReadyBackend(Arc::clone(&calls))));
+    cliprdr.process(&server_capabilities()).unwrap();
+    assert!(ready(&mut cliprdr).is_empty());
+    assert!(cliprdr.is_ready());
+    assert!(ready(&mut cliprdr).is_empty());
+    assert_eq!(*calls.lock().unwrap(), 1);
+}
+
+fn answer(cliprdr: &mut CliprdrClient, response: FormatDataResponse<'_>) {
+    cliprdr
+        .process(&pdu(ClipboardPdu::FormatDataResponse(response)))
+        .unwrap();
+}
+
+#[test]
+fn answer_kind_is_recorded_at_send_time() {
+    use RequestedFormat::{FileList, Other};
+
+    let (mut cliprdr, calls) = client();
+    ready(&mut cliprdr);
+    cliprdr.process(&remote_copy(&[file_list_format()])).unwrap();
+    cliprdr.process(&remote_copy(&[text_format()])).unwrap();
+    answer(&mut cliprdr, FormatDataResponse::new_data(vec![1]));
+    answer(&mut cliprdr, FormatDataResponse::new_unicode_string("text"));
+    answer(&mut cliprdr, FormatDataResponse::new_unicode_string("unsolicited"));
+    assert_eq!(
+        calls.lock().unwrap().answers,
+        [(Some(FileList), false), (Some(Other), false), (None, false)]
+    );
+}
+
+#[test]
+fn local_refusal_reports_its_own_kind_without_a_pending_entry() {
+    use RequestedFormat::{FileList, Other};
+
+    let (mut cliprdr, calls) = client();
+    ready(&mut cliprdr);
+    for _ in 0..64 {
+        cliprdr.process(&remote_copy(&[text_format()])).unwrap();
+    }
+    assert_eq!(
+        decoded(cliprdr.process(&remote_copy(&[file_list_format()])).unwrap()),
+        ["FormatListResponse::Ok"]
+    );
+    for _ in 0..65 {
+        answer(&mut cliprdr, FormatDataResponse::new_error());
+    }
+    let mut expected = vec![(Some(FileList), true)];
+    expected.extend([(Some(Other), true); 64]);
+    expected.push((None, true));
+    assert_eq!(calls.lock().unwrap().answers, expected);
+}
