diff --git a/crates/ironrdp-pdu/src/desktop_framebuffer.rs b/crates/ironrdp-pdu/src/desktop_framebuffer.rs
new file mode 100644
index 0000000..3f7851d
--- /dev/null
+++ b/crates/ironrdp-pdu/src/desktop_framebuffer.rs
@@ -0,0 +1,32 @@
+use core::fmt;
+
+pub const MAX_DESKTOP_EDGE: u32 = 8192;
+pub const MAX_DESKTOP_PIXELS: u32 = 67_108_864;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum DesktopFramebufferError {
+    Dimensions,
+    Allocation,
+}
+
+impl fmt::Display for DesktopFramebufferError {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::Dimensions => f.write_str("desktop dimensions exceed framebuffer limits"),
+            Self::Allocation => f.write_str("desktop framebuffer allocation failed"),
+        }
+    }
+}
+
+impl core::error::Error for DesktopFramebufferError {}
+
+pub fn desktop_pixel_count(width: u32, height: u32) -> Result<u32, DesktopFramebufferError> {
+    if !(1..=MAX_DESKTOP_EDGE).contains(&width) || !(1..=MAX_DESKTOP_EDGE).contains(&height) {
+        return Err(DesktopFramebufferError::Dimensions);
+    }
+    let pixels = width * height;
+    if pixels > MAX_DESKTOP_PIXELS {
+        return Err(DesktopFramebufferError::Dimensions);
+    }
+    Ok(pixels)
+}
