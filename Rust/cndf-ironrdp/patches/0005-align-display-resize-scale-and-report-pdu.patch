+#[cfg(test)]
+mod tests {
+    use super::*;
+    use ironrdp_dvc::pdu::{DrdynvcClientPdu, DrdynvcDataPdu};
+
+    #[test]
+    fn single_monitor_resize_encodes_desktop_scale_and_device_100() {
+        let client = DisplayControlClient::new(|_| Ok(Vec::new()));
+
+        for (width, height, scale) in [(1024, 700, 100), (2048, 1400, 200)] {
+            let messages = client
+                .encode_single_primary_monitor(1, width, height, Some(scale), None)
+                .unwrap();
+            let [message] = messages.as_slice() else {
+                panic!("expected one DVC message");
+            };
+            let wire = message.encode_unframed_pdu().unwrap();
+            let DrdynvcClientPdu::Data(DrdynvcDataPdu::Data(data)) = decode(&wire).unwrap() else {
+                panic!("expected a DVC data PDU");
+            };
+            let DisplayControlPdu::MonitorLayout(layout) = decode(data.data()).unwrap() else {
+                panic!("expected a Display Control monitor layout");
+            };
+            let [monitor] = layout.monitors() else {
+                panic!("expected a single primary monitor");
+            };
+            assert_eq!(monitor.dimensions(), (width, height));
+            assert_eq!(monitor.desktop_scale_factor(), Some(scale));
+            assert_eq!(monitor.device_scale_factor().map(|factor| factor.value()), Some(100));
+        }
+    }
+}
